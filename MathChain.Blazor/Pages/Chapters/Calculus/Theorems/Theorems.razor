@page "/theorems-calculus"
@inject IJSRuntime JS
@inject IDialogService DialogService
@using MathChain.Domain.Entities

<Component />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
	<MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Theorems</MudText>

	<MudGrid>
		@foreach (var formula in _formulas)
		{
			<MudItem xs="12" sm="6" md="4">
				<MudCard Elevation="4" Class="p-4" Style="background-color: #222222">
					<MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-2"></MudText>

					<div class="formula-card"
						 @onmouseenter="(() => Load3DModel(formula))"
						 @onmouseleave="(() => Unload3DModel(formula))"
						 @ondblclick="(() => OpenFormulaDialog(formula))">
						<div class="formula-2d">
							<span>
								@formula.Latex
							</span>
						</div>

						<div class="formula-3d">
							<canvas id="@($"{formula.Id}-canvas")"></canvas>
						</div>
					</div>
				</MudCard>
			</MudItem>
		}
	</MudGrid>
</MudContainer>

@code
{
	private static readonly string requirement = "Calculate the limit";

	private List<Formula> _formulas = new List<Formula>
	{
		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					&\text{Lagrange's Theorem:}\\
					& f:[a,b]\to \mathbb{R}\\
					& \left.\begin{matrix}
						f \text{ is continuous on } [a, b] \\
						f \text{ is derivative on } (a, b)
					\end{matrix}
					\right\} c\in(a,b) \text{ such that } f'(c)=\frac{f(b)-f(a)}{b-a}
					\end{aligned}$$",
			ModelPath = "Assets/3DModels/LR1.glb",
			Category = "Remarkable Limits",
			Description = "",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					& \text{L'Hopital:}\\
					& \lim_{x\to a}\frac{f(x)}{g(x)}=\lim_{x\to a}\frac{f'(x)}{g'(x)}\text{ for }\frac{0}{0}\text{ and }\frac{\infty}{\infty}
					\end{aligned}$$",
			ModelPath = "Assets/3DModels/LR1.glb",
			Category = "Remarkable Limits",
			Description = "",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					&\text{Root separation using Rolle's Theorem (for } f(x)=0\text{):}\\
					&\text{Steps:}\\
					&\text{I. Identify the function } f(x) \text{ and find its domain.}\\
					&\text{II. Solve } f'(x)=0 \text{ to determine the roots of the derivative.}\\
					&\text{III. Evaluate } f(x) \text{ at the critical points, at the boundaries of the domain,}\\
					&\quad\text{ and at points outside the domain to construct the sign table.}\\
					&\text{number of real roots} = \text{the number of sign changes.}
					\end{aligned}$$",
			ModelPath = "Assets/3DModels/LR1.glb",
			Category = "Remarkable Limits",
			Description = "",
			Requirement = $"{requirement}"
		},
	};

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await JS.InvokeVoidAsync("formatMath");
			await Task.Delay(400);
			await JS.InvokeVoidAsync("autoScaleFormulas");
		}
	}

	private async Task Load3DModel(Formula formula)
	{
		await JS.InvokeVoidAsync("math3D.loadModel", formula.Id + "-canvas", formula.ModelPath);
	}

	private async Task Unload3DModel(Formula formula)
	{
		await JS.InvokeVoidAsync("math3D.stopModel", formula.Id + "-canvas", formula.ModelPath);
	}

	private async Task OpenFormulaDialog(Formula formula)
	{
		var parameters = new DialogParameters<FormulaDialog>
		{
			{ x => x.Formula, formula},
			{ x => x.TotalFormulas, _formulas.Count  }
		};

		var options = new DialogOptions
		{
			CloseOnEscapeKey = true,
			MaxWidth = MaxWidth.Medium,
			FullWidth = true
		};

		await DialogService.ShowAsync<FormulaDialog>("Formula Details", parameters, options);
	}
}

