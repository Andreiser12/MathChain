          "variables": {
            "a": [2, 5]
          },
          "latexTemplate": "(x + {a})^2",
          "wolframQuery": "expand (x + {a})^2",
          "hint": "Aplică direct formula: primul termen la pătrat + dublul produsului + al doilea la pătrat.",
          "solutionIpfs": null
        },
        {
          "difficulty": "Easy",
          "order": 2,
          "variables": {
            "a": [2, 4]
          },
          "latexTemplate": "({a}x + 1)^2",
          "wolframQuery": "expand ({a}x + 1)^2",
          "hint": "Ai grijă să ridici și coeficientul numeric la pătrat: ({a}x)^2 = {a*a}x^2.",
          "solutionIpfs": null
        },
        {
          "difficulty": "Easy",
          "order": 3,
          "variables": {
