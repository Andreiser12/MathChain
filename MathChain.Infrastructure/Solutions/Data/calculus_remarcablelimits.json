          {
            "text": "Move the minus sign of the exponent outside the limit.",
            "latex": "= \\left(\\lim_{n\\to\\infty}\\left(1-\\frac{{a}}{n}\\right)^{n}\\right)^{-1}"
          },
          {
            "text": "The limit inside the parentheses is e raised to -{a}.",
            "latex": "= \\left(e^{-{a}}\\right)^{-1} = e^{{a}}"
          }
        ]
      },
      {
        "order": 7,
        "latexTemplate": "\\lim_{n\\to\\infty}\\left(\\frac{n+{a+b}}{n+{b}}\\right)^{n}",
        "wolframQuery": "e^{a}",
        "steps": [
          {
            "text": "Write the base as 1 plus a fraction.",
            "latex": "= \\lim_{n\\to\\infty}\\left(1+\\frac{{a}}{n+{b}}\\right)^{n}"
