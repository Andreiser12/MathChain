    "calculus_remarcablelimits-f1": [
      {
        "order": 1,
        "latexTemplate": "\\lim_{n\\to\\infty}\\left(1+\\frac{1}{n}\\right)^{{a}n}",
        "wolframQuery": "e^{a}",
        "steps": [
          {
            "text": "Write the expression as a power of the fundamental limit.",
            "latex": "= \\lim_{n\\to\\infty}\\left(\\left(1+\\frac{1}{n}\\right)^{n}\\right)^{{a}}"
          },
          {
            "text": "The inner limit is e, so the result is e raised to {a}.",
            "latex": "= e^{{a}}"
          }
        ]
      },
      {
        "order": 2,
        "latexTemplate": "\\lim_{n\\to\\infty}\\left(1+\\frac{{a}}{n}\\right)^{n}",
        "wolframQuery": "e^{a}",
        "steps": [
          {
            "text": "Substitute n = {a}t. When n tends to infinity, t tends to infinity too.",
            "latex": "= \\lim_{t\\to\\infty}\\left(1+\\frac{1}{t}\\right)^{{a}t}"
          },
          {
            "text": "Write it as a power of the fundamental limit.",
            "latex": "= \\lim_{t\\to\\infty}\\left(\\left(1+\\frac{1}{t}\\right)^{t}\\right)^{{a}} = e^{{a}}"
          }
        ]
      },
