@page "/geometric-progressions"
@inject IpfsService IpfsService
@inject IJSRuntime JS
@inject IDialogService DialogService
@using MathChain.Domain.Entities
@using MathChain.Blazor.DTOs

<Component />


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
	<MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Geometric Progressions</MudText>

	@if (_isLoading)
	{
		<MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height: 350px;">
			<MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
			<MudText Typo="Typo.h6" Class="mt-4" Style="color: rgba(255, 255, 255, 0.7);">
				Loading decentralized curriculum from IPFS...
			</MudText>
		</MudStack>
	}
	else if (_formulas == null || !_formulas.Any())
	{
		<MudPaper Class="pa-8 text-center" Style="background-color: #16213E;">
			<MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Large" />
			<MudText Typo="Typo.h6" Class="mt-2" Style="color: #ffffff;">No formulas could be loaded from IPFS.</MudText>
		</MudPaper>
	}
	else
	{
<MudGrid>
		@foreach (var formula in _formulas)
		{
			<MudItem xs="12" sm="6" md="4">
				<MudCard Elevation="4" Class="p-4" Style="background-color: #222222">
					<MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-2"></MudText>

					<div class="formula-card"
						 @onmouseenter="(() => Load3DModel(formula))"
						 @onmouseleave="(() => Unload3DModel(formula))"
						 @ondblclick="(() => OpenFormulaDialog(formula))">
						<div class="formula-2d">
							<span>
								@formula.Latex
							</span>
						</div>

						<div class="formula-3d">
							<canvas id="@($"{formula.Id}-canvas")"></canvas>
						</div>
					</div>
				</MudCard>
			</MudItem>
		}
	</MudGrid>
	}
</MudContainer>



@code
{
	private bool _isLoading = false;
	private bool _mathFormatted = false;
	private List<Formula> _formulas = new();

	private const string ChapterSlug = "algebra_geometricprogressions";
	private const string ChapterIpfsCid = "QmcksYBqHYNsKrYssnkRD1R2WiuhG24cJ2j6AtziFVLDCz";

	protected override async Task OnInitializedAsync()
	{
		_isLoading = true;
		try
		{
			var curriculum = await IpfsService.GetCurriculumBySlugAsync(ChapterSlug, ChapterIpfsCid);

			if (curriculum?.Formulas != null)
			{
				_formulas = curriculum.Formulas.Select(f => new Formula
					{
						Id = Guid.NewGuid(),
						Latex = f.Latex.StartsWith("$$") ? f.Latex : $"$${f.Latex}$$",
						ModelPath = f.Model3D,
						Category = curriculum.Category,
						Description = f.Description,
						Requirement = f.Requirement ?? f.Exercises.FirstOrDefault()?.LatexTemplate ?? ""
					}).ToList();
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading IPFS curriculum: {ex.Message}");
		}
		finally
		{
			_isLoading = false;
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (_formulas.Any() && !_mathFormatted)
		{
			_mathFormatted = true;
			await Task.Delay(100);
			await JS.InvokeVoidAsync("formatMath");
			await Task.Delay(200);
			await JS.InvokeVoidAsync("autoScaleFormulas");
		}
	}

	private async Task Load3DModel(Formula formula)
	{
		await JS.InvokeVoidAsync("math3D.loadModel", formula.Id + "-canvas", formula.ModelPath);
	}

	private async Task Unload3DModel(Formula formula)
	{
		await JS.InvokeVoidAsync("math3D.stopModel", formula.Id + "-canvas", formula.ModelPath);
	}

	private async Task OpenFormulaDialog(Formula formula)
	{
		var parameters = new DialogParameters<FormulaDialog>
		{
			{ x => x.Formula, formula },
			{ x => x.TotalFormulas, _formulas.Count }
		};

		var options = new DialogOptions
		{
			CloseOnEscapeKey = true,
			MaxWidth = MaxWidth.Medium,
			FullWidth = true
		};

		await DialogService.ShowAsync<FormulaDialog>("Formula Details", parameters, options);
	}
}
