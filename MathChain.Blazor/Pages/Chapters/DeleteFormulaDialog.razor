@using MudBlazor
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 600;">Delete Formula</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1">Are you sure you want to delete this formula?</MudText>
        <div id="@_elementId" class="delete-formula-rendered" style="overflow-x: auto; padding: 12px 0; font-size: 1.2rem;"></div>
        <code class="delete-formula-latex" style="display: block; font-size: 0.75rem; opacity: 0.7; word-break: break-all;">@Latex</code>
        <MudText Typo="Typo.caption" Style="opacity: 0.6;">@Title</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="Confirm" Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" id="confirm-delete-formula">
            Delete
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string Latex { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    private readonly string _elementId = $"delete-formula-{Guid.NewGuid():N}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("renderFormula", _elementId, Latex);
            }
            catch (JSException)
            {
            }
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Confirm()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}
