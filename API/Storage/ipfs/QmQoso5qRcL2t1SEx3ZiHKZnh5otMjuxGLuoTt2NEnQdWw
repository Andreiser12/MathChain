          "latexTemplate": "({a}x + {b}y)^2",
          "wolframQuery": "expand ({a}x + {b}y)^2",
          "hint": "Ai două variabile (x și y). Termenul din mijloc conține produsul xy.",
          "solutionIpfs": null
        },
        {
          "difficulty": "Medium",
          "order": 5,
