@page "/"
@page "/login"
@using MathChain.Domain.Enums
@inject IJSRuntime JS
@inject AppSession Session
@inject NavigationManager Nav
@inject ApiService Api
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
	<MudPaper Elevation="4" Class="pa-8 d-flex flex-column align-center gap-4" Style="background-color: #16213e; color: #ffffff; border-radius: 8px;">
		<MudText Typo="Typo.h4" Style="font-weight: 600; color: #ffffff;">Connect Wallet</MudText>
		<MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.6); text-align: center;">
			Alege portofelul pentru a te conecta în MathChain
		</MudText>

		<MudStack Spacing="3" Class="w-100 mt-2" Style="max-width: 320px;">
			<MudButton Variant="Variant.Filled"
					   Style="background-color: #f6851b; color: #ffffff; font-weight: 600; text-transform: none; font-size: 1.05rem;"
					   FullWidth="true"
					   Size="Size.Large"
					   StartIcon="@Icons.Material.Filled.AccountBalanceWallet"
					   OnClick='() => ConnectWithWallet("metamask")'>
				Connect MetaMask
			</MudButton>

			<MudButton Variant="Variant.Filled"
					   Style="background-color: #ab9ff2; color: #1a1a2e; font-weight: 600; text-transform: none; font-size: 1.05rem;"
					   FullWidth="true"
					   Size="Size.Large"
					   StartIcon="@Icons.Material.Filled.Token"
					   OnClick='() => ConnectWithWallet("phantom")'>
				Connect Phantom
			</MudButton>
		</MudStack>

		@if (!string.IsNullOrEmpty(_address))
		{
			<MudText Typo="Typo.body1"
					 Color="Color.Success" Class="mt-2">
				Connected: @_address[..8]...
			</MudText>
		}

		@if (!string.IsNullOrEmpty(_errorMessage))
		{
			<MudAlert Severity="Severity.Error" Class="mt-2 w-100">@_errorMessage</MudAlert>
		}
	</MudPaper>
</MudContainer>

@code {
	string _address = string.Empty;
	string _errorMessage = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		if (!Session.IsConnected)
		{
			await Session.RestoreSessionAsync();
		}

		if (Session.IsConnected)
		{
			if (Session.Role == UserRole.Teacher)
			{
				Nav.NavigateTo("/my-classes");
			}
			else
			{
				Nav.NavigateTo("/chapters");
			}
		}
	}

	async Task ConnectWithWallet(string walletType)
	{
		_errorMessage = string.Empty;

		try
		{
			string jsMethod = walletType == "phantom" ? "connectPhantom" : "connectMetaMask";
			_address = await JS.InvokeAsync<string>(jsMethod);

			if (string.IsNullOrEmpty(_address))
			{
				string walletName = walletType == "phantom" ? "Phantom" : "MetaMask";
				_errorMessage = $"Conexiunea cu {walletName} nu a fost confirmată. Verifică popup-ul extensiei (sau dacă portofelul este deblocat) și încearcă din nou.";
				return;
			}

			var userExists = await Api.CheckUserExistsAsync(_address);
			UserDto? user = null;

			if (userExists)
			{
				user = await Api.LoginAsync(_address, null);
			}
			else
			{
				var dialog = await DialogService.ShowAsync<ChooseRoleDialog>("Welcome to MathChain!");
				var result = await dialog.Result;

				if (result == null || result.Canceled || result.Data == null)
				{
					_errorMessage = "Trebuie să selectezi un rol pentru a continua.";
					return;
				}

				var chosenRole = result.Data.ToString();
				user = await Api.LoginAsync(_address, chosenRole);
			}

			if (user == null)
			{
				_errorMessage = "Nu s-a putut finaliza autentificarea. Te rugăm să încerci din nou.";
				return;
			}

			await Session.SetSessionAsync(_address, user.Role);

			if (user.Role == UserRole.Teacher)
			{
				Nav.NavigateTo("/my-classes");
			}
			else
			{
				Nav.NavigateTo("/chapters");
			}
		}
		catch (JSException jsEx)
		{
			_errorMessage = $"Eroare JavaScript la conectare: {jsEx.Message}";
			Console.WriteLine($"JSException: {jsEx.Message}");
		}
		catch (HttpRequestException httpEx)
		{
			_errorMessage = $"Eroare API Server ({httpEx.StatusCode}): Asigură-te că backend-ul rulează.";
			Console.WriteLine($"HttpRequestException: {httpEx.Message}");
		}
		catch (Exception ex)
		{
			_errorMessage = $"A apărut o eroare la autentificare: {ex.Message}";
			Console.WriteLine($"Exception: {ex.Message}");
		}
	}
}
