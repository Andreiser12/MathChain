@page "/practice"
@inject AppSession Session
@inject NavigationManager Nav
@inject ApiService Api
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using MathChain.Blazor.DTOs
@using MathChain.Domain.Enums
@using MathChain.Blazor.Pages.Solutions

<MudContainer MaxWidth="MaxWidth.ExtraLarge"
              Style="display: flex; flex-direction: column; height: 100vh; padding: 8px 16px; overflow: hidden; box-sizing: border-box;">

	<MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4" Align="Align.Center">
		Practice Arena
	</MudText>

    <MudGrid Style="flex: 1; min-height: 0;">
        <MudItem xs="8" Style="height: 100%;">
            <MudPaper Class="pa-6"
                      Style="height: 100%; background-color: #16213E; display: flex; flex-direction: column; border-radius: 0px !important;">

                <div class="d-flex flex-column justify-center align-center" style="flex: 1">

                    @if (!string.IsNullOrEmpty(_loadError))
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-3">@_loadError</MudAlert>
                    }
                    else if(string.IsNullOrEmpty(_currentLatex))
                    {
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-3" />
                        <MudText Typo="Typo.h5">Loading exercise...</MudText>
                    }
                    else
                    {
                        @if (ExerciseCount > 0)
                        {
                            <div class="d-flex align-center gap-2 mb-3">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Style="border-radius: 0px;">
                                    Exercise @(_currentIndex + 1) of @ExerciseCount
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="@CurrentDifficultyColor" Variant="Variant.Outlined" Style="border-radius: 0px;">
                                    @_currentDifficulty
                                </MudChip>
                                @if (_solved.Contains(_currentIndex))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Style="border-radius: 0px;">
                                        ✓ Solved
                                    </MudChip>
                                }
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Style="color: #90caf9;">
                                    Completed: @_solved.Count / @ExerciseCount
                                </MudChip>
                            </div>
                        }

                        <MudText Typo="Typo.h5" Class="mb-4" Align="Align.Center" Style="color: #ffffff; max-width: 650px;">
                            @(_exercise?.Requirement)
                        </MudText>
                    }

                    <div id="formula-display" style="font-size: 2.2rem; min-height: 60px;"></div>
                </div>

                <div>
                    <MudText Class="mb-2">
                        @AnswerLabel
                    </MudText>
                    <MudTextField @bind-Value="_userAnswer"
                                  Variant="Variant.Outlined"
                                  Placeholder="@AnswerPlaceholder"
                                  Style="border-radius: 0px !important;" />
                    <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.6);" Class="mt-1">
                        @AnswerHelp
                    </MudText>
                </div>

            </MudPaper>
        </MudItem>

        <MudItem xs="4" Style="height: 100%;">
            <ScientificCalculator OnPasteResult="OnCalculatorPaste" />
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Style="width: 100%;" Class="mt-2" Justify="Justify.SpaceBetween">
        <MudButton Variant="Variant.Filled" Style="background-color: #B71C1C; border-radius: 0px;" OnClick="ExitPractice">Exit</MudButton>
        <MudButton Variant="Variant.Filled" Style="background-color: #005ea6; border-radius: 0px;"
                   OnClick="PreviousExercise"
                   Disabled="@(ExerciseCount <= 1 || _currentIndex <= 0 || _busy)">
            Previous
        </MudButton>
        <MudButton Variant="Variant.Filled" Style="background-color: #FF8F00; border-radius: 0px;" OnClick="ShowHint">Hint</MudButton>
        <MudButton Variant="Variant.Filled" Style="background-color: #7C4DFF; border-radius: 0px; text-transform: none;" id="view-solution"
                   Disabled="@(!CanOpenSolution || _busy)" OnClick="ViewSolutionAsync">@SolutionButtonText</MudButton>
        <MudButton Variant="Variant.Filled" Style="background-color: #76FF03; color: #000; font-weight: bold; border-radius: 0px;" Disabled="@(_busy || _exercise == null)" OnClick="VerifyAnswer">Verify Answer</MudButton>
        <MudButton Variant="Variant.Filled" Style="background-color: #005ea6; border-radius: 0px;"
                   OnClick="NextExercise"
                   Disabled="@(ExerciseCount <= 1 || _currentIndex >= ExerciseCount - 1 || _busy)">
            Next
        </MudButton>
    </MudStack>

</MudContainer>


@code {
    private PracticeFormulaDto? _formula;
    private PracticeExerciseDto? _exercise;
    private SolutionOfferDto? _offer;
    private HashSet<int> _solved = new();
    private int _currentIndex;
    private string _userAnswer = "";
    private string _currentLatex = "";
    private string? _loadError;
    private bool _busy;

    private int ExerciseCount => _formula?.Exercises.Count ?? 0;

    private SolutionOfferItemDto? CurrentOffer => _offer?.Exercises.FirstOrDefault(e => e.Index == _currentIndex);

    private bool SolutionUnlocked => _offer != null && CurrentOffer != null && (_offer.FreeAccess || CurrentOffer.Purchased);

    private bool CanOpenSolution => _exercise != null && CurrentOffer != null && CurrentOffer.HasSolution
        && (SolutionUnlocked || (_offer!.CanPurchase && CurrentOffer.Price != null));

    private string SolutionButtonText
    {
        get
        {
            if (CurrentOffer == null || !CurrentOffer.HasSolution)
            {
                return "No solution yet";
            }

            if (SolutionUnlocked || CurrentOffer.Price == null)
            {
                return "View Solution";
            }

            return $"View Solution · {CurrentOffer.Price.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} {_offer!.TokenSymbol}";
        }
    }

    private string _currentDifficulty => _exercise?.Difficulty ?? "Easy";

    private Color CurrentDifficultyColor =>
        _currentDifficulty == "Easy" ? Color.Success : (_currentDifficulty == "Medium" ? Color.Warning : Color.Error);

    private string AnswerLabel => _exercise?.Form switch
    {
        AnswerForm.Expanded => "Enter the expanded expression:",
        AnswerForm.Factored => "Enter the expression as a product of factors:",
        AnswerForm.Simplified => "Enter the simplified expression:",
        _ => "Enter your result (number with maximum 3 decimal places):"
    };

    private string AnswerPlaceholder => _exercise?.Form switch
    {
        AnswerForm.Expanded => "e.g. x^2 + 6x + 9",
        AnswerForm.Factored => "e.g. (x - 3)(x + 3)",
        AnswerForm.Simplified => "e.g. 8x^2 + 14x + 3",
        _ => "e.g. 7 or -14"
    };

    private string AnswerHelp => _exercise == null
        ? string.Empty
        : (_exercise.Form == AnswerForm.Number
            ? $"Attempts left: {_exercise.AttemptsLeft}"
            : $"Use ^ for powers and sqrt(5) for roots. Attempts left: {_exercise.AttemptsLeft}");

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsConnected)
        {
            await Session.RestoreSessionAsync();
        }

        if (!Session.IsConnected)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Session.CurrentFormula == null)
        {
            await Session.RestoreCurrentFormulaAsync();
        }

        if (Session.CurrentFormula == null)
        {
            Nav.NavigateTo("/chapters");
            return;
        }

        var result = await Api.GetPracticeFormulaAsync(Session.CurrentFormula.Id);

        if (!result.Success || result.Data == null)
        {
            _loadError = result.Error ?? "The exercises could not be loaded.";
            return;
        }

        _formula = result.Data;
        _solved = new HashSet<int>(_formula.SolvedIndices);
        await LoadOfferAsync();
        _currentIndex = Enumerable.Range(0, ExerciseCount).FirstOrDefault(i => !_solved.Contains(i), 0);

        await LoadExerciseAsync();

        if (_currentIndex > 0)
        {
            Snackbar.Add($"Resumed from Exercise {_currentIndex + 1} of {ExerciseCount}", Severity.Info);
        }
    }

    private async Task LoadExerciseAsync()
    {
        if (_formula == null || ExerciseCount == 0)
        {
            return;
        }

        _userAnswer = "";
        _currentLatex = "";
        _exercise = null;
        StateHasChanged();

        var result = await Api.StartPracticeExerciseAsync(_formula.FormulaId, _currentIndex);

        if (!result.Success || result.Data == null)
        {
            _loadError = result.Error ?? "The exercise could not be loaded.";
            StateHasChanged();
            return;
        }

        _loadError = null;
        _exercise = result.Data;
        _currentLatex = _exercise.Latex;
        StateHasChanged();
    }

    private void OnCalculatorPaste(string result)
    {
        _userAnswer = result;
        Snackbar.Add($"Result {result} pasted into answer!", Severity.Info);
        StateHasChanged();
    }

    private async Task NextExercise()
    {
        if (_currentIndex < ExerciseCount - 1)
        {
            _currentIndex++;
            await LoadExerciseAsync();
        }
    }

    private async Task PreviousExercise()
    {
        if (_currentIndex > 0)
        {
            _currentIndex--;
            await LoadExerciseAsync();
        }
    }

    private void ShowHint()
    {
        if (!string.IsNullOrWhiteSpace(_exercise?.Hint))
        {
            Snackbar.Add($"Hint: {_exercise.Hint}", Severity.Info);
        }
        else
        {
            Snackbar.Add("Remember: \\int a dx = a*x + C. The coefficient of x is the constant term.", Severity.Info);
        }
    }

    private async Task LoadOfferAsync()
    {
        if (_formula == null)
        {
            return;
        }

        var offer = await Api.GetSolutionOfferAsync(_formula.FormulaId);
        _offer = offer.Success ? offer.Data : null;
    }

    private async Task ViewSolutionAsync()
    {
        if (_formula == null || _exercise == null || CurrentOffer == null)
        {
            return;
        }

        if (!SolutionUnlocked)
        {
            var payment = await DialogService.ShowAsync<SolutionPaymentDialog>("Step-by-step solution", new DialogParameters<SolutionPaymentDialog>
            {
                { x => x.FormulaId, _formula.FormulaId },
                { x => x.Index, _currentIndex },
                { x => x.Difficulty, CurrentOffer.Difficulty },
                { x => x.Price, CurrentOffer.Price ?? 0 },
                { x => x.TokenSymbol, _offer!.TokenSymbol }
            }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });

            var paid = await payment.Result;
            await LoadOfferAsync();
            StateHasChanged();

            if (paid == null || paid.Canceled || !SolutionUnlocked)
            {
                return;
            }
        }

        await DialogService.ShowAsync<SolutionDialog>("Step-by-step solution", new DialogParameters<SolutionDialog>
        {
            { x => x.ExerciseId, _exercise.ExerciseId },
            { x => x.ExerciseLatex, _exercise.Latex }
        }, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
    }

    void ExitPractice()
    {
        Nav.NavigateTo("/chapters");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrEmpty(_currentLatex))
        {
            await JS.InvokeVoidAsync("renderFormula", "formula-display", _currentLatex);
        }
    }

    private async Task VerifyAnswer()
    {
        if (_exercise == null || _busy)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_userAnswer))
        {
            Snackbar.Add("Please enter an answer.", Severity.Warning);
            return;
        }

        _busy = true;
        var response = await Api.SubmitPracticeAnswerAsync(_exercise.ExerciseId, _userAnswer);
        _busy = false;

        if (!response.Success || response.Data == null)
        {
            Snackbar.Add(response.Error ?? "The answer could not be checked.", Severity.Error);
            await LoadExerciseAsync();
            return;
        }

        var result = response.Data;
        _solved = new HashSet<int>(result.SolvedIndices);
        _exercise.AttemptsLeft = result.AttemptsLeft;

        if (result.Correct)
        {
            Snackbar.Add(_solved.Count >= ExerciseCount
                ? $"Congratulations! All {ExerciseCount} exercises for this formula are completed!"
                : $"Correct! Exercise {_currentIndex + 1} of {ExerciseCount} solved!", Severity.Success);
        }
        else if (result.Verdict == "Unreadable")
        {
            Snackbar.Add(result.Message, Severity.Warning);
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Error);

            if (result.AttemptsLeft == 0)
            {
                Snackbar.Add("No attempts left for this exercise. A new exercise was loaded.", Severity.Info);
                await LoadExerciseAsync();
            }
        }

        StateHasChanged();
    }
}
