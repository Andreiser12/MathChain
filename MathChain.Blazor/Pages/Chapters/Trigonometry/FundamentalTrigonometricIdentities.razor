@page "/fundamental-trigonometric-identities"
@inject IJSRuntime JS
@inject AppSession Session
@inject NavigationManager Nav

<style>
	.hover-effect {
		transition: all 0.3s ease-in-out;
		border: 2px solid transparent;
	}

		.hover-effect:hover {
			transform: translateY(-5px);
			border: 2px solid #536DFE;
			box-shadow: 0 0 15px rgba(83, 109, 254, 0.4);
		}

</style>


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
	<MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Fundamental Trigonometric Identities</MudText>

	<MudGrid>
		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="4"
					 Class="cursor-pointer hover-effect"
					 @onclick='() => Nav.NavigateTo("/fundamental-formula-trigonometry")'>
				<MudCardMedia Image="Assets/Images/Integrals_Image.png"
							  Height="200">
				</MudCardMedia>
				<MudCardContent>
					<MudText Typo="Typo.h6" Align="Align.Center">Fundamental Formula</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="4"
					 Class="cursor-pointer hover-effect"
					 @onclick='() => Nav.NavigateTo("/reference-angle-trigonometry")'>
				<MudCardMedia Image="Assets/Images/Integrals_Image.png"
							  Height="200">
				</MudCardMedia>
				<MudCardContent>
					<MudText Typo="Typo.h6" Align="Align.Center">Reference Angle</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="4"
					 Class="cursor-pointer hover-effect"
					 @onclick='() => Nav.NavigateTo("/parity-trigonometry")'>
				<MudCardMedia Image="Assets/Images/Integrals_Image.png"
							  Height="200">
				</MudCardMedia>
				<MudCardContent>
					<MudText Typo="Typo.h6" Align="Align.Center">Parity</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="4"
					 Class="cursor-pointer hover-effect"
					 @onclick='() => Nav.NavigateTo("/periodicity-trigonometry")'>
				<MudCardMedia Image="Assets/Images/Integrals_Image.png"
							  Height="200">
				</MudCardMedia>
				<MudCardContent>
					<MudText Typo="Typo.h6" Align="Align.Center">Periodicity</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="4"
					 Class="cursor-pointer hover-effect"
					 @onclick='() => Nav.NavigateTo("/sums-trigonometry")'>
				<MudCardMedia Image="Assets/Images/Integrals_Image.png"
							  Height="200">
				</MudCardMedia>
				<MudCardContent>
					<MudText Typo="Typo.h6" Align="Align.Center">Sums</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="4"
					 Class="cursor-pointer hover-effect"
					 @onclick='() => Nav.NavigateTo("/multi-angle-trigonometry")'>
				<MudCardMedia Image="Assets/Images/Integrals_Image.png"
							  Height="200">
				</MudCardMedia>
				<MudCardContent>
					<MudText Typo="Typo.h6" Align="Align.Center">Multi Angle</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="4"
					 Class="cursor-pointer hover-effect"
					 @onclick='() => Nav.NavigateTo("/sums-to-products-trigonometry")'>
				<MudCardMedia Image="Assets/Images/Integrals_Image.png"
							  Height="200">
				</MudCardMedia>
				<MudCardContent>
					<MudText Typo="Typo.h6" Align="Align.Center">Sums to Products</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="4"
					 Class="cursor-pointer hover-effect"
					 @onclick='() => Nav.NavigateTo("/products-to-sums-trigonometry")'>
				<MudCardMedia Image="Assets/Images/Integrals_Image.png"
							  Height="200">
				</MudCardMedia>
				<MudCardContent>
					<MudText Typo="Typo.h6" Align="Align.Center">Products to Sums</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="4"
					 Class="cursor-pointer hover-effect"
					 @onclick='() => Nav.NavigateTo("/weierstrass-substitution-trigonometry")'>
				<MudCardMedia Image="Assets/Images/Integrals_Image.png"
							  Height="200">
				</MudCardMedia>
				<MudCardContent>
					<MudText Typo="Typo.h6" Align="Align.Center">Weierstrass Substitution</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="4"
					 Class="cursor-pointer hover-effect"
					 @onclick='() => Nav.NavigateTo("/fundamental-equations-trigonometry")'>
				<MudCardMedia Image="Assets/Images/Integrals_Image.png"
							  Height="200">
				</MudCardMedia>
				<MudCardContent>
					<MudText Typo="Typo.h6" Align="Align.Center">Fundamental Equations</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>
	</MudGrid>

</MudContainer>



@code
{
	protected override void OnInitialized()
	{
		if (!Session.IsConnected)
		{
			Nav.NavigateTo("/login");
		}
	}
}
