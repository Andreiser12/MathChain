@page "/chapters"
@page "/chapters/{ChapterIdOrSlug}"
@using MathChain.Domain.Entities
@using MathChain.Domain.Enums
@using MathChain.Blazor.DTOs
@using MudBlazor
@inject IJSRuntime JS
@inject AppSession Session
@inject NavigationManager Nav
@inject ApiService Api
@inject IpfsService IpfsService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<Component />

<style>
	.hover-effect {
		transition: all 0.3s ease-in-out;
		border: 2px solid transparent;
		position: relative;
	}

	.hover-effect:hover {
		transform: translateY(-5px);
		border: 2px solid #536DFE;
		box-shadow: 0 0 15px rgba(83, 109, 254, 0.4);
	}

	.card-admin-actions {
		position: absolute;
		top: 8px;
		right: 8px;
		background: rgba(22, 33, 62, 0.9);
		backdrop-filter: blur(4px);
		border-radius: 20px;
		padding: 2px 4px;
		z-index: 2;
	}

	.admin-header-actions {
		position: absolute;
		right: 0;
		top: 50%;
		transform: translateY(-50%);
	}

	@@media (max-width: 960px) {
		.header-container {
			flex-direction: column;
		}
		.admin-header-actions {
			position: static;
			transform: none;
			margin-top: 16px;
		}
	}
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-12">
	@if (!string.IsNullOrEmpty(ChapterIdOrSlug))
	{
		<MudBreadcrumbs Items="_breadcrumbItems" Class="pa-0 mb-4" Separator=">">
			<ItemTemplate Context="item">
				<MudLink Href="@item.Href" Typo="Typo.body2" Style="color: #90caf9; font-weight: 500;">
					@item.Text
				</MudLink>
			</ItemTemplate>
		</MudBreadcrumbs>
	}

	<div class="position-relative d-flex justify-center align-center mb-6 header-container">
		<div class="text-center px-4">
			<MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight: 600; color: #ffffff;">
				@PageTitle
			</MudText>
			@if (!string.IsNullOrEmpty(PageDescription))
			{
				<MudText Typo="Typo.body1" Align="Align.Center" Class="mt-1" Style="color: rgba(255, 255, 255, 0.7); max-width: 800px; margin: 0 auto;">
					@PageDescription
				</MudText>
			}
		</div>

		@if (Session.Role == UserRole.Admin)
		{
			<div class="admin-header-actions">
				<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
					@if (IsRootLevel)
					{
						<MudButton Variant="Variant.Filled"
								   Color="Color.Primary"
								   StartIcon="@Icons.Material.Filled.Add"
								   OnClick="OpenCreateRootChapterDialog">
							New Chapter
						</MudButton>
					}
					else
					{
						<MudButton Variant="Variant.Filled"
								   Color="Color.Primary"
								   StartIcon="@Icons.Material.Filled.Add"
								   OnClick="OpenCreateSubChapterDialog">
							New Subchapter
						</MudButton>

						<MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Dense="true">
							<MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="OpenEditCurrentChapterDialog">
								Edit Chapter
							</MudMenuItem>
							<MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="ConfirmDeleteCurrentChapter">
								Delete Chapter
							</MudMenuItem>
						</MudMenu>
					}
				</MudStack>
			</div>
		}
	</div>

	@if (_isLoading)
	{
		<MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height: 350px;">
			<MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
			<MudText Typo="Typo.h6" Class="mt-4" Style="color: rgba(255, 255, 255, 0.7);">
				Loading chapters...
			</MudText>
		</MudStack>
	}
	else if (HasSubChapters || HasFormulas)
	{
		@if (HasSubChapters)
		{
			@if (HasFormulas)
			{
				<MudText Typo="Typo.h5" Style="font-weight: 600; color: #ffffff;" Class="mb-3">
					Subchapters
				</MudText>
			}

			<MudGrid Class="@(HasFormulas ? "mb-8" : "")">
				@foreach (var chapter in DisplayedChapters)
				{
					<MudItem xs="12" sm="6" md="4">
						<MudCard Elevation="4"
								 Class="cursor-pointer hover-effect h-100 d-flex flex-column justify-space-between"
								 Style="background-color: #16213E; color: #ffffff;"
								 @onclick="() => NavigateToChapter(chapter)">

							@if (Session.Role == UserRole.Admin)
							{
								<div class="card-admin-actions" @onclick:stopPropagation="true">
									<MudIconButton Icon="@Icons.Material.Filled.Add"
												   Size="Size.Small"
												   Color="Color.Primary"
												   aria-label="Add Subchapter"
												   OnClick="() => OpenCreateSubForCard(chapter)" />
									<MudIconButton Icon="@Icons.Material.Filled.Edit"
												   Size="Size.Small"
												   Color="Color.Warning"
												   aria-label="Edit"
												   OnClick="() => OpenEditCard(chapter)" />
									<MudIconButton Icon="@Icons.Material.Filled.Delete"
												   Size="Size.Small"
												   Color="Color.Error"
												   aria-label="Delete"
												   OnClick="() => ConfirmDeleteCard(chapter)" />
								</div>
							}

							<div>
								<MudCardMedia Image="@GetValidImageUrl(chapter.ImageUrl)"
											  Height="200" />
								<MudCardContent Class="pa-4 d-flex flex-column align-center text-center">
									<MudText Typo="Typo.h6" Align="Align.Center" Style="font-weight: 600; color: #ffffff; width: 100%;" Class="mb-1">
										@chapter.Title
									</MudText>

									@if (!string.IsNullOrEmpty(chapter.Description))
									{
										<MudText Typo="Typo.body2" Align="Align.Center" Style="color: rgba(255, 255, 255, 0.6); line-height: 1.4;" Class="mb-2">
											@chapter.Description
										</MudText>
									}

									<div class="d-flex justify-center align-center flex-wrap gap-2 mt-2">
										@if (chapter.TotalSubChaptersCount > 0)
										{
											<MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
												@(chapter.TotalSubChaptersCount == 1 ? "1 Subchapter" : $"{chapter.TotalSubChaptersCount} Subchapters")
											</MudChip>
										}
										@if (chapter.TotalFormulasCount > 0)
										{
											<MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
												@(chapter.TotalFormulasCount == 1 ? "1 Formula" : $"{chapter.TotalFormulasCount} Formulas")
											</MudChip>
										}
										else if (chapter.TotalSubChaptersCount == 0 && !string.IsNullOrEmpty(chapter.IpfsHash))
										{
											<MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
												Formulas
											</MudChip>
										}
									</div>
								</MudCardContent>
							</div>
						</MudCard>
					</MudItem>
				}
			</MudGrid>
		}

		@if (HasFormulas)
		{
			@if (HasSubChapters)
			{
				<MudText Typo="Typo.h5" Style="font-weight: 600; color: #ffffff;" Class="mb-3">
					Formulas
				</MudText>
			}

			<MudGrid>
				@foreach (var formula in _formulas)
				{
					<MudItem xs="12" sm="6" md="4">
						<MudCard Elevation="4" Class="pa-4 h-100" Style="background-color: #222222; border-radius: 8px;">
							<div class="formula-card"
								 @onmouseenter="(() => Load3DModel(formula))"
								 @onmouseleave="(() => Unload3DModel(formula))"
								 @ondblclick="(() => OpenFormulaDialog(formula))">
								<div class="formula-2d">
									<span>
										@formula.Latex
									</span>
								</div>

								<div class="formula-3d">
									<canvas id="@($"{formula.Id}-canvas")"></canvas>
								</div>
							</div>
						</MudCard>
					</MudItem>
				}
			</MudGrid>
		}
	}
	else
	{
		<MudPaper Class="pa-12 text-center mt-6" Style="background-color: #16213E; border-radius: 8px;">
			<MudIcon Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" Size="Size.Large" Style="font-size: 4rem;" />
			<MudText Typo="Typo.h5" Class="mt-4" Style="color: #ffffff; font-weight: 600;">
				This chapter does not contain any subchapters or formulas yet.
			</MudText>
			<MudText Typo="Typo.body1" Class="mt-2 mb-6" Style="color: rgba(255, 255, 255, 0.6); max-width: 600px; margin: 0 auto;">
				@if (Session.Role == UserRole.Admin)
				{
					<span>You can use the button below to create the first subchapter or edit this chapter to link formulas.</span>
				}
				else
				{
					<span>Content for this chapter will be available soon.</span>
				}
			</MudText>

			@if (Session.Role == UserRole.Admin)
			{
				<MudButton Variant="Variant.Filled"
						   Color="Color.Primary"
						   Size="Size.Large"
						   StartIcon="@Icons.Material.Filled.Add"
						   OnClick="OpenCreateSubChapterDialog">
					New Subchapter
				</MudButton>
			}
		</MudPaper>
	}
</MudContainer>

@code
{
	[Parameter]
	public string? ChapterIdOrSlug { get; set; }

	private bool _isLoading = true;
	private bool _mathFormatted = false;

	private bool IsRootLevel => string.IsNullOrWhiteSpace(ChapterIdOrSlug);

	private List<CurriculumChapterDto> DisplayedChapters { get; set; } = new();
	private ChapterDetailDto? _currentDetail;
	private List<Formula> _formulas = new();
	private List<BreadcrumbItem> _breadcrumbItems = new();

	private readonly DialogOptions _dialogOptions = new DialogOptions
	{
		CloseOnEscapeKey = true,
		MaxWidth = MaxWidth.Small,
		FullWidth = true
	};

	private string PageTitle => IsRootLevel
		? "Select a Chapter"
		: (_currentDetail?.Chapter.Title ?? "Chapter Details");

	private string? PageDescription => IsRootLevel
		? null
		: _currentDetail?.Chapter.Description;

	private bool HasSubChapters => DisplayedChapters.Any();
	private bool HasFormulas => _formulas.Any();

	protected override async Task OnInitializedAsync()
	{
		if (!Session.IsConnected)
		{
			await Session.RestoreSessionAsync();
		}

		if (!Session.IsConnected)
		{
			Nav.NavigateTo("/login");
			return;
		}

		await LoadDataAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		await LoadDataAsync();
	}

	private async Task LoadDataAsync()
	{
		_isLoading = true;
		_mathFormatted = false;
		_formulas.Clear();
		DisplayedChapters.Clear();
		_currentDetail = null;
		_breadcrumbItems.Clear();

		try
		{
			if (IsRootLevel)
			{
				DisplayedChapters = await Api.GetRootChaptersAsync();
			}
			else
			{
				_currentDetail = await Api.GetChapterDetailAsync(ChapterIdOrSlug!);

				if (_currentDetail != null)
				{
					DisplayedChapters = _currentDetail.SubChapters;

					// Build breadcrumbs
					_breadcrumbItems.Add(new BreadcrumbItem("Chapters", "/chapters"));
					foreach (var b in _currentDetail.Breadcrumbs)
					{
						_breadcrumbItems.Add(new BreadcrumbItem(b.Title, $"/chapters/{b.Slug}"));
					}

					// Try to load formulas from IPFS if IpfsHash exists
					if (!string.IsNullOrEmpty(_currentDetail.Chapter.IpfsHash))
					{
						await LoadCurriculumFormulasAsync(_currentDetail.Chapter.ChapterSlug, _currentDetail.Chapter.IpfsHash);
					}
				}
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading chapter data: {ex.Message}");
			Snackbar.Add($"Error loading chapters: {ex.Message}", Severity.Error);
		}
		finally
		{
			_isLoading = false;
			StateHasChanged();
		}
	}

	private async Task LoadCurriculumFormulasAsync(string slug, string ipfsHash)
	{
		try
		{
			var curriculum = await IpfsService.GetCurriculumBySlugAsync(slug, ipfsHash);
			if (curriculum?.Formulas != null)
			{
				_formulas = curriculum.Formulas.Select(f => new Formula
				{
					Id = Guid.NewGuid(),
					Latex = f.Latex.StartsWith("$$") ? f.Latex : $"$${f.Latex}$$",
					ModelPath = f.Model3D,
					Category = curriculum.Category,
					Description = f.Description,
					Requirement = f.Requirement ?? f.Exercises.FirstOrDefault()?.LatexTemplate ?? ""
				}).ToList();
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading IPFS formulas: {ex.Message}");
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (_formulas.Any() && !_mathFormatted)
		{
			_mathFormatted = true;
			await Task.Delay(100);
			try
			{
				await JS.InvokeVoidAsync("formatMath");
				await Task.Delay(200);
				await JS.InvokeVoidAsync("autoScaleFormulas");
			}
			catch { }
		}
	}

	private void NavigateToChapter(CurriculumChapterDto chapter)
	{
		Nav.NavigateTo($"/chapters/{chapter.ChapterSlug}");
	}

	private string GetValidImageUrl(string? url)
	{
		if (string.IsNullOrWhiteSpace(url))
		{
			return "Assets/Images/Calculus_Image.png";
		}
		return url;
	}

	#region Admin Actions

	private async Task OpenCreateRootChapterDialog()
	{
		var parameters = new DialogParameters<CreateEditChapterDialog>
		{
			{ x => x.IsEdit, false },
			{ x => x.ParentId, null }
		};

		var dialog = await DialogService.ShowAsync<CreateEditChapterDialog>("Create New Chapter", parameters, _dialogOptions);
		var result = await dialog.Result;

		if (result != null && !result.Canceled && result.Data is CreateChapterDto dto)
		{
			var created = await Api.CreateChapterAsync(dto);
			if (created != null)
			{
				Snackbar.Add($"Chapter '{created.Title}' created successfully!", Severity.Success);
				await LoadDataAsync();
			}
			else
			{
				Snackbar.Add("Failed to create chapter.", Severity.Error);
			}
		}
	}

	private async Task OpenCreateSubChapterDialog()
	{
		if (_currentDetail == null) return;

		var parameters = new DialogParameters<CreateEditChapterDialog>
		{
			{ x => x.IsEdit, false },
			{ x => x.ParentId, _currentDetail.Chapter.Id },
			{ x => x.ParentTitle, _currentDetail.Chapter.Title }
		};

		var dialog = await DialogService.ShowAsync<CreateEditChapterDialog>("Add New Subchapter", parameters, _dialogOptions);
		var result = await dialog.Result;

		if (result != null && !result.Canceled && result.Data is CreateChapterDto dto)
		{
			var created = await Api.CreateChapterAsync(dto);
			if (created != null)
			{
				Snackbar.Add($"Subchapter '{created.Title}' added successfully!", Severity.Success);
				await LoadDataAsync();
			}
			else
			{
				Snackbar.Add("Failed to create subchapter.", Severity.Error);
			}
		}
	}

	private async Task OpenCreateSubForCard(CurriculumChapterDto chapter)
	{
		var parameters = new DialogParameters<CreateEditChapterDialog>
		{
			{ x => x.IsEdit, false },
			{ x => x.ParentId, chapter.Id },
			{ x => x.ParentTitle, chapter.Title }
		};

		var dialog = await DialogService.ShowAsync<CreateEditChapterDialog>($"Add Subchapter to {chapter.Title}", parameters, _dialogOptions);
		var result = await dialog.Result;

		if (result != null && !result.Canceled && result.Data is CreateChapterDto dto)
		{
			var created = await Api.CreateChapterAsync(dto);
			if (created != null)
			{
				Snackbar.Add($"Subchapter '{created.Title}' added successfully!", Severity.Success);
				await LoadDataAsync();
			}
			else
			{
				Snackbar.Add("Failed to create subchapter.", Severity.Error);
			}
		}
	}

	private async Task OpenEditCard(CurriculumChapterDto chapter)
	{
		var parameters = new DialogParameters<CreateEditChapterDialog>
		{
			{ x => x.IsEdit, true },
			{ x => x.ExistingChapter, chapter },
			{ x => x.ParentId, chapter.ParentId }
		};

		var dialog = await DialogService.ShowAsync<CreateEditChapterDialog>("Edit Chapter", parameters, _dialogOptions);
		var result = await dialog.Result;

		if (result != null && !result.Canceled && result.Data is UpdateChapterDto dto)
		{
			var updated = await Api.UpdateChapterAsync(chapter.Id, dto);
			if (updated != null)
			{
				Snackbar.Add($"Chapter '{updated.Title}' updated successfully!", Severity.Success);
				await LoadDataAsync();
			}
			else
			{
				Snackbar.Add("Failed to update chapter.", Severity.Error);
			}
		}
	}

	private async Task OpenEditCurrentChapterDialog()
	{
		if (_currentDetail == null) return;
		await OpenEditCard(_currentDetail.Chapter);
	}

	private async Task ConfirmDeleteCard(CurriculumChapterDto chapter)
	{
		bool? confirmed = await DialogService.ShowMessageBoxAsync(
			"Delete Chapter",
			$"Are you sure you want to delete chapter '{chapter.Title}'? All of its subchapters and formulas will also be deleted.",
			yesText: "Delete",
			cancelText: "Cancel");

		if (confirmed == true)
		{
			var success = await Api.DeleteChapterAsync(chapter.Id);
			if (success)
			{
				Snackbar.Add($"Chapter '{chapter.Title}' was deleted.", Severity.Info);
				await LoadDataAsync();
			}
			else
			{
				Snackbar.Add("Failed to delete chapter.", Severity.Error);
			}
		}
	}

	private async Task ConfirmDeleteCurrentChapter()
	{
		if (_currentDetail == null) return;

		bool? confirmed = await DialogService.ShowMessageBoxAsync(
			"Delete Chapter",
			$"Are you sure you want to delete chapter '{_currentDetail.Chapter.Title}'? All of its subchapters and formulas will also be deleted.",
			yesText: "Delete",
			cancelText: "Cancel");

		if (confirmed == true)
		{
			var parentSlug = _currentDetail.Breadcrumbs.Count > 1
				? _currentDetail.Breadcrumbs[^2].Slug
				: null;

			var success = await Api.DeleteChapterAsync(_currentDetail.Chapter.Id);
			if (success)
			{
				Snackbar.Add($"Chapter '{_currentDetail.Chapter.Title}' was deleted.", Severity.Info);
				if (!string.IsNullOrEmpty(parentSlug))
				{
					Nav.NavigateTo($"/chapters/{parentSlug}");
				}
				else
				{
					Nav.NavigateTo("/chapters");
				}
			}
			else
			{
				Snackbar.Add("Failed to delete chapter.", Severity.Error);
			}
		}
	}

	#endregion

	#region 3D Formulas

	private async Task Load3DModel(Formula formula)
	{
		try
		{
			await JS.InvokeVoidAsync("math3D.loadModel", formula.Id + "-canvas", formula.ModelPath);
		}
		catch { }
	}

	private async Task Unload3DModel(Formula formula)
	{
		try
		{
			await JS.InvokeVoidAsync("math3D.stopModel", formula.Id + "-canvas", formula.ModelPath);
		}
		catch { }
	}

	private async Task OpenFormulaDialog(Formula formula)
	{
		var parameters = new DialogParameters<FormulaDialog>
		{
			{ x => x.Formula, formula },
			{ x => x.TotalFormulas, _formulas.Count }
		};

		var options = new DialogOptions
		{
			CloseOnEscapeKey = true,
			MaxWidth = MaxWidth.Medium,
			FullWidth = true
		};

		await DialogService.ShowAsync<FormulaDialog>("Formula Details", parameters, options);
	}

	#endregion
}
