@inherits LayoutComponentBase
@implements IDisposable
@inject AppSession Session
@inject NavigationManager Nav

<MudThemeProvider Theme="@_mudTheme" IsDarkMode=true />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

	@if (Session.IsConnected)
	{
		@if (!IsPracticePage())

		{
			<MudAppBar>

				<MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
							   Color="Color.Inherit" OnClick="GoBack" />
			</MudAppBar>
		}

		<MudDrawer @bind-Open="_drawerOpen"
				   Elevation="2">
			<MudNavMenu>
				<MudText Typo="Typo.h5"
						 Color="Color.Primary"
						 Align="Align.Center"
						 Class="my-4">
					Mathchain
				</MudText>
				<MudDivider />
				<MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
				<MudDivider />
				<MudNavLink Href="/chapters" Icon="@Icons.Material.Filled.MenuBook">Chapters</MudNavLink>
				<MudDivider />
				<MudNavLink Href="/my-classes" Icon="@Icons.Material.Filled.Class">My Classes</MudNavLink>
				<MudDivider />
				<MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
				<MudDivider />
				<MudNavLink Href="/account" Icon="@Icons.Material.Filled.AccountCircle">Account</MudNavLink>
				<MudDivider />
				<MudNavLink OnClick="HandleLogout" Icon="@Icons.Material.Filled.Logout" Style="color: #ff5252; cursor: pointer;">Disconnect</MudNavLink>
				<MudDivider />
			</MudNavMenu>
		</MudDrawer>

	}

	<MudMainContent Style="@(IsPracticePage() ? "padding-top: 0 !important;" : "")">
		@Body
	</MudMainContent>

</MudLayout>

@code
{
	private MudTheme _mudTheme = new MudTheme()
	{
		PaletteDark = new PaletteDark()
		{
			Primary = Colors.Indigo.Accent4,
			Background = "#1A1A2E",
			Surface = "#16213E",
			AppbarBackground = "#0F3460"
		}
	};

	private bool _drawerOpen = true;

	protected override async Task OnInitializedAsync()
	{
		Session.OnChange += StateHasChanged;
		if (!Session.IsConnected)
		{
			await Session.RestoreSessionAsync();
		}
	}

	public void Dispose()
	{
		Session.OnChange -= StateHasChanged;
	}

	private void DrawerToggle()
	{
		_drawerOpen = !_drawerOpen;
	}

	private bool IsPracticePage()
	{
		return Nav.Uri.Contains("/practice");
	}

	void GoBack()
	{
		Nav.NavigateTo("javascript:history.back()");
	}

	async Task HandleLogout()
	{
		await Session.LogoutAsync();
		Nav.NavigateTo("/login");
	}
}
