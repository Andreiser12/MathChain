@page "/chapters"
@page "/chapters/{ChapterIdOrSlug}"
@using MathChain.Domain.Entities
@using MathChain.Domain.Enums
@using MathChain.Blazor.DTOs
@using MudBlazor
@inject IJSRuntime JS
@inject AppSession Session
@inject NavigationManager Nav
@inject ApiService Api
@inject IpfsService IpfsService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<Component />

<style>
	.hover-effect {
		transition: all 0.3s ease-in-out;
		border: 2px solid transparent;
		position: relative;
	}

	.hover-effect:hover {
		transform: translateY(-5px);
		border: 2px solid #536DFE;
		box-shadow: 0 0 15px rgba(83, 109, 254, 0.4);
	}

	.mode-selection-container {
		padding-top: 16px !important;
		padding-bottom: 20px !important;
		min-height: calc(100vh - var(--mud-appbar-height, 64px));
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
	}

	.mode-selection-grid {
		flex: 1 1 auto;
		width: 100%;
	}

	.mode-selection-card {
		background-color: #005ea6 !important;
		border-radius: 0px !important;
		height: calc(100vh - var(--mud-appbar-height, 64px) - 36px) !important;
		min-height: 480px;
		width: 100%;
		transition: background-color 0.2s ease-in-out;
		cursor: pointer;
		user-select: none;
		border: none !important;
		box-shadow: none !important;
	}

	.mode-selection-card:hover {
		background-color: #006ec4 !important;
		box-shadow: none !important;
		border: none !important;
	}

	@@media (max-width: 959px) {
		.mode-selection-container {
			min-height: auto;
			padding-bottom: 32px !important;
		}

		.mode-selection-card {
			height: 260px !important;
			min-height: 260px !important;
		}
	}

	.card-admin-actions {
		position: absolute;
		top: 8px;
		right: 8px;
		background: rgba(22, 33, 62, 0.9);
		backdrop-filter: blur(4px);
		border-radius: 20px;
		padding: 2px 4px;
		z-index: 2;
	}

	.chapter-page-header {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		width: 100%;
		margin-bottom: 24px;
	}

	.header-title-box {
		text-align: center;
		width: 100%;
		padding: 0 240px;
	}

	.header-actions-box {
		position: absolute;
		right: 0;
		top: 50%;
		transform: translateY(-50%);
		z-index: 5;
	}

	@@media (max-width: 960px) {
		.chapter-page-header {
			flex-direction: column;
			gap: 16px;
		}
		.header-title-box {
			padding: 0;
		}
		.header-actions-box {
			position: static;
			transform: none;
		}
	}
</style>

@if (ShowSourceSelection)
{
	<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mode-selection-container">
		<MudGrid Spacing="6" Justify="Justify.Center" Class="mode-selection-grid">
			<!-- CARD 1: For Main Leaderboard -->
			<MudItem xs="12" md="6" Class="d-flex">
				<MudPaper Elevation="0"
						  Square="true"
						  Class="mode-selection-card d-flex align-center justify-center pa-6"
						  @onclick="SelectMainLeaderboard">
					<MudText Align="Align.Center" Style="font-size: 2.2rem; font-weight: 500; color: #ffffff;">
						For Main Leaderboard
					</MudText>
				</MudPaper>
			</MudItem>

			<!-- CARD 2: From Your Classes -->
			<MudItem xs="12" md="6" Class="d-flex">
				<MudPaper Elevation="0"
						  Square="true"
						  Class="mode-selection-card d-flex align-center justify-center pa-6"
						  @onclick="SelectFromClasses">
					<MudText Align="Align.Center" Style="font-size: 2.2rem; font-weight: 500; color: #ffffff;">
						From Your Classes
					</MudText>
				</MudPaper>
			</MudItem>
		</MudGrid>
	</MudContainer>
}
else
{
	<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-12">
		@if (Session.Role == UserRole.Student && IsRootLevel)
		{
			<div class="d-flex align-center justify-space-between mb-4">
				<MudButton Variant="Variant.Text"
						   StartIcon="@Icons.Material.Filled.ArrowBack"
						   Style="color: #90caf9; text-transform: none; font-size: 1.05rem;"
						   OnClick="ReturnToModeSelection">
					← Back to Mode Selection
				</MudButton>
				<MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Style="font-weight: 500;">
					Main Leaderboard
				</MudChip>
			</div>
		}

		@if (!string.IsNullOrEmpty(ChapterIdOrSlug))
		{
			<MudBreadcrumbs Items="_breadcrumbItems" Class="pa-0 mb-4" Separator=">">
				<ItemTemplate Context="item">
					<MudLink Href="@item.Href" Typo="Typo.body2" Style="color: #90caf9; font-weight: 500;">
						@item.Text
					</MudLink>
				</ItemTemplate>
			</MudBreadcrumbs>
		}

		<div class="chapter-page-header mb-6">
		<div class="header-title-box">
			@if (_isLoading && !IsRootLevel)
			{
				<div class="d-flex flex-column align-center">
					<MudSkeleton SkeletonType="SkeletonType.Text" Width="260px" Height="42px" Animation="Animation.Wave" Style="background-color: rgba(255, 255, 255, 0.08);" />
					<MudSkeleton SkeletonType="SkeletonType.Text" Width="420px" Height="20px" Animation="Animation.Wave" Class="mt-1" Style="background-color: rgba(255, 255, 255, 0.05);" />
				</div>
			}
			else
			{
				<MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight: 600; color: #ffffff;">
					@PageTitle
				</MudText>
				@if (!string.IsNullOrEmpty(PageDescription))
				{
					<MudText Typo="Typo.body1" Align="Align.Center" Class="mt-1" Style="color: rgba(255, 255, 255, 0.7); max-width: 800px; margin: 0 auto;">
						@PageDescription
					</MudText>
				}
			}
		</div>

		@if (Session.Role == UserRole.Admin)
		{
			<div class="header-actions-box">
				<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
					@if (IsRootLevel)
					{
						<MudButton Variant="Variant.Filled"
								   Color="Color.Primary"
								   StartIcon="@Icons.Material.Filled.Add"
								   OnClick="OpenCreateRootChapterDialog">
							New Chapter
						</MudButton>
					}
					else
					{
						<MudButton Variant="Variant.Filled"
								   Color="Color.Primary"
								   StartIcon="@Icons.Material.Filled.Add"
								   OnClick="OpenCreateSubChapterDialog">
							New Subchapter
						</MudButton>

						<MudButton Variant="Variant.Outlined"
								   Color="Color.Success"
								   StartIcon="@Icons.Material.Filled.Add"
								   OnClick="OpenCreateFormulaDialog">
							New Formula
						</MudButton>

						<MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Dense="true">
							<MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="OpenEditCurrentChapterDialog">
								Edit Chapter
							</MudMenuItem>
							<MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="ConfirmDeleteCurrentChapter">
								Delete Chapter
							</MudMenuItem>
						</MudMenu>
					}
				</MudStack>
			</div>
		}
	</div>

	@if (_isLoading)
	{
		<MudGrid>
			@for (int i = 0; i < 6; i++)
			{
				<MudItem xs="12" sm="6" md="4">
					<MudCard Elevation="4" Style="background-color: #16213E; border-radius: 8px; overflow: hidden;" Class="h-100">
						<MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Animation="Animation.Wave" Style="background-color: rgba(255, 255, 255, 0.05);" />
						<MudCardContent Class="pa-4 d-flex flex-column align-center text-center">
							<MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" Height="32px" Animation="Animation.Wave" Class="mb-2" Style="background-color: rgba(255, 255, 255, 0.08);" />
							<MudSkeleton SkeletonType="SkeletonType.Text" Width="85%" Height="18px" Animation="Animation.Wave" Class="mb-1" Style="background-color: rgba(255, 255, 255, 0.04);" />
							<MudSkeleton SkeletonType="SkeletonType.Text" Width="50%" Height="18px" Animation="Animation.Wave" Class="mb-3" Style="background-color: rgba(255, 255, 255, 0.04);" />
							<div class="d-flex justify-center gap-2">
								<MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="85px" Height="24px" Style="border-radius: 12px; background-color: rgba(255, 255, 255, 0.06);" Animation="Animation.Wave" />
								<MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="75px" Height="24px" Style="border-radius: 12px; background-color: rgba(255, 255, 255, 0.06);" Animation="Animation.Wave" />
							</div>
						</MudCardContent>
					</MudCard>
				</MudItem>
			}
		</MudGrid>
	}
	else if (HasSubChapters || HasFormulas)
	{
		@if (HasSubChapters)
		{
			@if (HasFormulas)
			{
				<MudText Typo="Typo.h5" Style="font-weight: 600; color: #ffffff;" Class="mb-3">
					Subchapters
				</MudText>
			}

			<MudGrid Class="@(HasFormulas ? "mb-8" : "")">
				@foreach (var chapter in DisplayedChapters)
				{
					<MudItem xs="12" sm="6" md="4">
						<MudCard Elevation="4"
								 Class="cursor-pointer hover-effect h-100 d-flex flex-column justify-space-between"
								 Style="background-color: #16213E; color: #ffffff;"
								 @onclick="() => NavigateToChapter(chapter)">

							@if (Session.Role == UserRole.Admin)
							{
								<div class="card-admin-actions" @onclick:stopPropagation="true">
									<MudTooltip Text="Edit Chapter" Arrow="true" Placement="Placement.Top">
										<MudIconButton Icon="@Icons.Material.Filled.Edit"
													   Size="Size.Small"
													   Color="Color.Warning"
													   aria-label="Edit"
													   OnClick="() => OpenEditCard(chapter)" />
									</MudTooltip>
									<MudTooltip Text="Delete Chapter" Arrow="true" Placement="Placement.Top">
										<MudIconButton Icon="@Icons.Material.Filled.Delete"
													   Size="Size.Small"
													   Color="Color.Error"
													   aria-label="Delete"
													   OnClick="() => ConfirmDeleteCard(chapter)" />
									</MudTooltip>
								</div>
							}

							<div>
								<MudCardMedia Image="@GetValidImageUrl(chapter.ImageUrl)"
											  Height="200" />
								<MudCardContent Class="pa-4 d-flex flex-column align-center text-center">
									<MudText Typo="Typo.h6" Align="Align.Center" Style="font-weight: 600; color: #ffffff; width: 100%;" Class="mb-1">
										@chapter.Title
									</MudText>

									@if (!string.IsNullOrEmpty(chapter.Description))
									{
										<MudText Typo="Typo.body2" Align="Align.Center" Style="color: rgba(255, 255, 255, 0.6); line-height: 1.4;" Class="mb-2">
											@chapter.Description
										</MudText>
									}

									<div class="d-flex justify-center align-center flex-wrap gap-2 mt-2">
										@if (chapter.TotalSubChaptersCount > 0)
										{
											<MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
												@(chapter.TotalSubChaptersCount == 1 ? "1 Subchapter" : $"{chapter.TotalSubChaptersCount} Subchapters")
											</MudChip>
										}
										@if (chapter.TotalFormulasCount > 0)
										{
											<MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
												@(chapter.TotalFormulasCount == 1 ? "1 Formula" : $"{chapter.TotalFormulasCount} Formulas")
											</MudChip>
										}
										else if (chapter.TotalSubChaptersCount == 0 && !string.IsNullOrEmpty(chapter.IpfsHash))
										{
											<MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
												Formulas
											</MudChip>
										}
									</div>
								</MudCardContent>
							</div>
						</MudCard>
					</MudItem>
				}
			</MudGrid>
		}

		@if (HasFormulas)
		{
			@if (HasSubChapters)
			{
				<MudText Typo="Typo.h5" Style="font-weight: 600; color: #ffffff;" Class="mb-3">
					Formulas
				</MudText>
			}

			<MudGrid>
				@foreach (var formula in _formulas)
				{
					<MudItem xs="12" sm="6" md="4">
						<MudCard Elevation="4" Class="pa-4 h-100 position-relative" Style="background-color: #222222; border-radius: 8px;">
							@if (Session.Role == UserRole.Admin)
							{
								<div class="card-admin-actions" @onclick:stopPropagation="true">
									<MudIconButton Icon="@Icons.Material.Filled.Edit"
												   Size="Size.Small"
												   Color="Color.Warning"
												   aria-label="Edit Formula"
												   OnClick="() => OpenEditFormula(formula)" />
									<MudIconButton Icon="@Icons.Material.Filled.Delete"
												   Size="Size.Small"
												   Color="Color.Error"
												   aria-label="Delete Formula"
												   OnClick="() => ConfirmDeleteFormula(formula)" />
								</div>
							}

							<div class="formula-card"
								 @onmouseenter="(() => Load3DModel(formula))"
								 @onmouseleave="(() => Unload3DModel(formula))"
								 @ondblclick="(() => OpenFormulaDialog(formula))">
								<div class="formula-2d">
									<span>
										@formula.Latex
									</span>
								</div>

								<div class="formula-3d">
									<canvas id="@($"{formula.Id}-canvas")"></canvas>
								</div>
							</div>
						</MudCard>
					</MudItem>
				}
			</MudGrid>
		}
	}
	else
	{
		<MudPaper Class="pa-12 text-center mt-6" Style="background-color: #16213E; border-radius: 8px;">
			<MudIcon Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" Size="Size.Large" Style="font-size: 4rem;" />
			<MudText Typo="Typo.h5" Class="mt-4" Style="color: #ffffff; font-weight: 600;">
				@(IsRootLevel ? "No chapters available yet." : "This chapter does not contain any subchapters or formulas yet.")
			</MudText>
			<MudText Typo="Typo.body1" Class="mt-2 mb-6" Style="color: rgba(255, 255, 255, 0.6); max-width: 600px; margin: 0 auto;">
				@if (Session.Role == UserRole.Admin)
				{
					<span>@(IsRootLevel ? "Click the button below to create the first chapter." : "You can use the buttons below to create a subchapter or add the first formula.")</span>
				}
				else
				{
					<span>Content will be available soon.</span>
				}
			</MudText>

			@if (Session.Role == UserRole.Admin)
			{
				<MudStack Row="true" Spacing="2" Justify="Justify.Center">
					@if (IsRootLevel)
					{
						<MudButton Variant="Variant.Filled"
								   Color="Color.Primary"
								   Size="Size.Large"
								   StartIcon="@Icons.Material.Filled.Add"
								   OnClick="OpenCreateRootChapterDialog">
							New Chapter
						</MudButton>
					}
					else
					{
						<MudButton Variant="Variant.Filled"
								   Color="Color.Primary"
								   Size="Size.Large"
								   StartIcon="@Icons.Material.Filled.Add"
								   OnClick="OpenCreateSubChapterDialog">
							New Subchapter
						</MudButton>

						<MudButton Variant="Variant.Outlined"
								   Color="Color.Success"
								   Size="Size.Large"
								   StartIcon="@Icons.Material.Filled.Add"
								   OnClick="OpenCreateFormulaDialog">
							New Formula
						</MudButton>
					}
				</MudStack>
			}
		</MudPaper>
	}
	</MudContainer>
}

@code
{
	[Parameter]
	public string? ChapterIdOrSlug { get; set; }

	[SupplyParameterFromQuery(Name = "source")]
	public string? Source { get; set; }

	private bool IsLeaderboardSource =>
		string.Equals(Source, "leaderboard", StringComparison.OrdinalIgnoreCase) ||
		Nav.Uri.Contains("source=leaderboard", StringComparison.OrdinalIgnoreCase);

	private bool ShowSourceSelection =>
		IsRootLevel &&
		Session.Role == UserRole.Student &&
		!IsLeaderboardSource;

	private void SelectMainLeaderboard()
	{
		Nav.NavigateTo("/chapters?source=leaderboard");
	}

	private void SelectFromClasses()
	{
		Nav.NavigateTo("/my-classes");
	}

	private void ReturnToModeSelection()
	{
		Nav.NavigateTo("/chapters");
	}

	private bool _isLoading = true;
	private bool _mathFormatted = false;

	private bool IsRootLevel => string.IsNullOrWhiteSpace(ChapterIdOrSlug);

	private List<CurriculumChapterDto> DisplayedChapters { get; set; } = new();
	private ChapterDetailDto? _currentDetail;
	private List<Formula> _formulas = new();
	private List<BreadcrumbItem> _breadcrumbItems = new();

	private readonly DialogOptions _dialogOptions = new DialogOptions
	{
		CloseOnEscapeKey = true,
		MaxWidth = MaxWidth.Small,
		FullWidth = true
	};

	private string PageTitle => IsRootLevel
		? "Select a Chapter"
		: (_currentDetail?.Chapter.Title ?? "Chapter Details");

	private string? PageDescription => IsRootLevel
		? null
		: _currentDetail?.Chapter.Description;

	private bool HasSubChapters => DisplayedChapters.Any();
	private bool HasFormulas => _formulas.Any();

	private string? _lastLoadedSlug;

	protected override async Task OnInitializedAsync()
	{
		if (!Session.IsConnected)
		{
			await Session.RestoreSessionAsync();
		}

		if (!Session.IsConnected)
		{
			Nav.NavigateTo("/login");
			return;
		}

		// OnParametersSetAsync runs immediately after OnInitializedAsync, avoiding duplicate loading calls.
	}

	private bool _hasLoadedRoot;

	protected override async Task OnParametersSetAsync()
	{
		if (ShowSourceSelection)
		{
			_isLoading = false;
			StateHasChanged();
			return;
		}

		bool needsLoad = IsRootLevel
			? (!_hasLoadedRoot || !string.IsNullOrEmpty(_lastLoadedSlug) || !DisplayedChapters.Any())
			: (ChapterIdOrSlug != _lastLoadedSlug || _currentDetail == null);

		if (needsLoad)
		{
			await LoadDataAsync();
		}
	}

	private async Task LoadDataAsync()
	{
		_isLoading = true;
		_mathFormatted = false;
		_formulas.Clear();
		_breadcrumbItems.Clear();

		try
		{
			if (IsRootLevel)
			{
				_hasLoadedRoot = true;
				_lastLoadedSlug = null;
				_currentDetail = null;
				var roots = await Api.GetRootChaptersAsync();
				DisplayedChapters = roots;
			}
			else
			{
				_hasLoadedRoot = false;
				_lastLoadedSlug = ChapterIdOrSlug;
				_currentDetail = await Api.GetChapterDetailAsync(ChapterIdOrSlug!);

				if (_currentDetail != null)
				{
					DisplayedChapters = _currentDetail.SubChapters;

					// Build breadcrumbs
					if (Session.Role == UserRole.Student)
					{
						_breadcrumbItems.Add(new BreadcrumbItem("Mode Selection", "/chapters"));
						_breadcrumbItems.Add(new BreadcrumbItem("Chapters", "/chapters?source=leaderboard"));
					}
					else
					{
						_breadcrumbItems.Add(new BreadcrumbItem("Chapters", "/chapters"));
					}

					foreach (var b in _currentDetail.Breadcrumbs)
					{
						_breadcrumbItems.Add(new BreadcrumbItem(b.Title, $"/chapters/{b.Slug}"));
					}

					// Only load formulas if this chapter has formulas or is a leaf category
					bool shouldLoadFormulas = (_currentDetail.Chapter.FormulasCount > 0) || !DisplayedChapters.Any();

					if (shouldLoadFormulas)
					{
						var dbFormulas = await Api.GetFormulasByChapterAsync(_currentDetail.Chapter.Id.ToString());
						if (dbFormulas.Any())
						{
							_formulas = dbFormulas.Select(f => new Formula
							{
								Id = f.Id,
								Title = f.Title,
								FormulaCode = f.FormulaCode,
								Latex = f.Latex.StartsWith("$$") ? f.Latex : $"$${f.Latex}$$",
								ModelPath = f.Model3D ?? "",
								Category = _currentDetail.Chapter.Category,
								Description = f.Description ?? "",
								Requirement = f.Requirement ?? "",
								ExercisesJson = f.ExercisesJson,
								Order = f.Order
							}).ToList();
						}
						else if (!string.IsNullOrEmpty(_currentDetail.Chapter.IpfsHash))
						{
							// Fallback to IPFS/JSON if DB has none yet
							await LoadCurriculumFormulasAsync(_currentDetail.Chapter.ChapterSlug, _currentDetail.Chapter.IpfsHash);
						}
					}
				}
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading chapter data: {ex.Message}");
			Snackbar.Add($"Error loading chapters: {ex.Message}", Severity.Error);
		}
		finally
		{
			_isLoading = false;
			StateHasChanged();
		}
	}

	private async Task LoadCurriculumFormulasAsync(string slug, string ipfsHash)
	{
		try
		{
			var curriculum = await IpfsService.GetCurriculumBySlugAsync(slug, ipfsHash);
			if (curriculum?.Formulas != null)
			{
				_formulas = curriculum.Formulas.Select(f => new Formula
				{
					Id = Guid.NewGuid(),
					Title = f.Title,
					Latex = f.Latex.StartsWith("$$") ? f.Latex : $"$${f.Latex}$$",
					ModelPath = f.Model3D,
					Category = curriculum.Category,
					Description = f.Description,
					Requirement = f.Requirement ?? f.Exercises.FirstOrDefault()?.LatexTemplate ?? ""
				}).ToList();
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading IPFS formulas: {ex.Message}");
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (_formulas.Any() && !_mathFormatted)
		{
			_mathFormatted = true;
			await Task.Delay(100);
			try
			{
				await JS.InvokeVoidAsync("formatMath");
				await Task.Delay(200);
				await JS.InvokeVoidAsync("autoScaleFormulas");
			}
			catch { }
		}
	}

	private void NavigateToChapter(CurriculumChapterDto chapter)
	{
		Nav.NavigateTo($"/chapters/{chapter.ChapterSlug}");
	}

	private string GetValidImageUrl(string? url)
	{
		if (string.IsNullOrWhiteSpace(url))
		{
			return "Assets/Images/Calculus_Image.png";
		}
		return url;
	}

	#region Admin Chapter Actions

	private async Task OpenCreateRootChapterDialog()
	{
		var parameters = new DialogParameters<CreateEditChapterDialog>
		{
			{ x => x.IsEdit, false },
			{ x => x.ParentId, null }
		};

		var dialog = await DialogService.ShowAsync<CreateEditChapterDialog>("Create New Chapter", parameters, _dialogOptions);
