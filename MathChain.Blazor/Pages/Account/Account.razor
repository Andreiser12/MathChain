@page "/account"
@inject AppSession Session
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Account - MathChain</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 px-4">
    <MudCard Elevation="4" Style="background-color: #16213e; color: #ffffff; border-radius: 4px;">
        <MudCardHeader>
            <CardHeaderAvatar>
                <MudAvatar Color="Color.Primary" Size="Size.Large">
                    <MudIcon Icon="@(Session.Role == UserRole.Teacher ? Icons.Material.Filled.School : Icons.Material.Filled.Person)" />
                </MudAvatar>
            </CardHeaderAvatar>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Style="font-weight: 600; color: #ffffff;">Profil Cont</MudText>
                <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.6);">Detalii sesiune MathChain</MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent Class="px-6 py-4">
            <MudStack Spacing="4">
                <div>
                    <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.6);">ROL CURENT</MudText>
                    <div class="mt-1">
                        @if (Session.Role == UserRole.Teacher)
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.School">
                                Profesor (Teacher)
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Person">
                                Elev / Student
                            </MudChip>
                        }
                    </div>
                </div>

                <MudDivider Style="background-color: rgba(255, 255, 255, 0.1);" />

                <div>
                    <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.6);">ADRESĂ PORTOFEL (METAMASK)</MudText>
                    <MudPaper Elevation="0" Class="d-flex align-center justify-space-between pa-3 mt-1" Style="background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);">
                        <MudText Style="font-family: monospace; font-size: 0.95rem; color: #90caf9; word-break: break-all;">
                            @Session.WalletAddress
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" Size="Size.Small" OnClick="CopyAddress" title="Copiază adresa" />
                    </MudPaper>
                </div>

                <MudDivider Style="background-color: rgba(255, 255, 255, 0.1);" />

                <div>
                    <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.6);">STATUS CONEXIUNE</MudText>
                    <div class="d-flex align-center gap-2 mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.body2" Color="Color.Success">Conectat activ prin MetaMask</MudText>
                    </div>
                </div>
            </MudStack>
        </MudCardContent>

        <MudCardActions Class="px-6 py-4 d-flex justify-space-between align-center" Style="background-color: rgba(0, 0, 0, 0.15);">
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick='() => Nav.NavigateTo("/dashboard")'>
                Înapoi la Dashboard
            </MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout" OnClick="Disconnect">
                Deconectare (Logout)
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsConnected)
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task CopyAddress()
    {
        if (!string.IsNullOrEmpty(Session.WalletAddress))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Session.WalletAddress);
            Snackbar.Add("Adresa a fost copiată!", Severity.Info);
        }
    }

    private void Disconnect()
    {
        Session.Logout();
        Nav.NavigateTo("/login");
    }
}
