@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using System.Globalization
@using System.Text.RegularExpressions

<style>
    .calc-container {
        height: 100%;
        background-color: #16213E;
        border-radius: 4px;
        padding: 14px;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        position: relative;
    }

    .calc-display {
        background-color: #f1f5f9;
        border-radius: 4px;
        padding: 8px 14px;
        min-height: 82px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border: 1px solid #cbd5e1;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.08);
        cursor: text;
        box-sizing: border-box;
    }

    .calc-expression-input {
        width: 100%;
        background: transparent;
        border: none;
        outline: none;
        color: #1e293b;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 1.35rem;
        font-weight: 600;
        text-align: right;
        padding: 2px 0;
        margin: 0;
        cursor: text;
        box-sizing: border-box;
    }

    .calc-expression-input::placeholder {
        color: #94a3b8;
    }

    .calc-result-text {
        color: #0f172a;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 1.85rem;
        font-weight: 700;
        text-align: right;
        overflow-x: auto;
        white-space: nowrap;
    }

    .calc-copy-btn {
        background-color: #005ea6 !important;
        color: #ffffff !important;
        font-weight: 600 !important;
        font-size: 0.95rem !important;
        text-transform: none !important;
        padding: 5px 18px !important;
        border-radius: 3px !important;
        box-shadow: none !important;
        outline: none !important;
        border: none !important;
    }

    .calc-copy-btn:hover {
        background-color: #004e8a !important;
    }

    .calc-divider {
        border-bottom: 2px solid #005ea6;
        margin: 6px 0 10px 0;
        width: 100%;
    }

    /* Grila tastaturii principale: 4 coloane x 5 randuri, umple complet tot spatiul pana jos */
    .calc-grid-layout {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: repeat(5, 1fr);
        gap: 10px;
        flex: 1;
        min-height: 0;
        width: 100%;
        height: 100%;
    }

    /* Butoane solide, patrate, merg pana jos */
    .calc-btn {
        background-color: #005ea6 !important;
        color: #ffffff !important;
        font-size: 1.25rem !important;
        font-weight: 600 !important;
        border-radius: 4px !important;
        min-width: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        height: 100% !important;
        min-height: 0 !important;
        text-transform: none !important;
        transition: background-color 0.15s ease-in-out !important;
        box-shadow: none !important;
        border: none !important;
        outline: none !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        user-select: none !important;
    }

    .calc-btn:hover {
        background-color: #004e8a !important;
    }

    /* Fara efecte speciale: Fara glow, fara bordura colorata la activare sau focus */
    .calc-btn.active,
    .calc-btn:focus,
    .calc-btn:focus-visible,
    .flyout-btn:focus,
    .flyout-btn:focus-visible {
        background-color: #004e8a !important;
        box-shadow: none !important;
        border: none !important;
        outline: none !important;
    }

    .calc-btn-span2 {
        grid-column: span 2;
    }

    .calc-btn-clear {
        background-color: #e53935 !important;
        font-weight: 700 !important;
        font-size: 1.35rem !important;
    }

    .calc-btn-clear:hover {
        background-color: #c62828 !important;
    }

    /* Panoul plutitor spre stanga cu butoane patrate */
    .calc-flyout-panel {
        position: absolute;
        right: calc(100% + 14px);
        background-color: #0d1b38;
        border: 2px solid #005ea6;
        border-radius: 6px;
        padding: 12px;
        box-shadow: -8px 10px 30px rgba(0, 0, 0, 0.7);
        z-index: 100;
        animation: flyoutIn 0.15s ease-out;
    }

    @@keyframes flyoutIn {
        from { opacity: 0; transform: translateX(8px); }
        to { opacity: 1; transform: translateX(0); }
    }

    /* Grile pentru meniul expandat: butoane patrate 85px x 85px */
    .flyout-grid-4col {
        display: grid;
        grid-template-columns: repeat(4, 85px);
        grid-auto-rows: 85px;
        gap: 10px;
    }

    .flyout-grid-3col {
        display: grid;
        grid-template-columns: repeat(3, 85px);
        grid-auto-rows: 85px;
        gap: 10px;
    }

    .flyout-grid-2col {
        display: grid;
        grid-template-columns: repeat(2, 85px);
        grid-auto-rows: 85px;
        gap: 10px;
    }

    .flyout-btn {
        background-color: #005ea6 !important;
        color: #ffffff !important;
        font-size: 1.25rem !important;
        font-weight: 600 !important;
        border-radius: 4px !important;
        text-transform: none !important;
        box-shadow: none !important;
        border: none !important;
        outline: none !important;
        width: 100% !important;
        height: 100% !important;
        min-width: 85px !important;
        min-height: 85px !important;
        aspect-ratio: 1 / 1 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        transition: background-color 0.15s ease-in-out !important;
        user-select: none !important;
    }

    .flyout-btn-smalltext {
        font-size: 1.05rem !important;
    }

    .flyout-btn:hover {
        background-color: #004e8a !important;
    }

    .flyout-btn-span2 {
        grid-column: span 2;
    }
</style>

<div class="calc-container" onclick="if(!event.target.closest('button')) document.getElementById('calc-main-input')?.focus();">
    <!-- 1. Display Screen (LCD Box) - clic oriunde focalizeaza instant tastatura -->
    <div class="calc-display mb-2" onclick="document.getElementById('calc-main-input')?.focus();">
        <input id="calc-main-input"
               @ref="_inputRef"
               class="calc-expression-input"
               value="@_expression"
               @oninput="OnInputTyped"
               @onkeydown="HandleKeyDown"
               placeholder="0"
               autocomplete="off"
               spellcheck="false"
               autofocus />
        <div class="calc-result-text">
            @_displayResult
        </div>
    </div>

    <!-- 2. Copy & Paste Row (curat, aliniat la dreapta) -->
    <div class="d-flex justify-end mb-1 px-1">
        <MudButton Variant="Variant.Filled"
                   Class="calc-copy-btn"
                   onmousedown="event.preventDefault()"
                   OnClick="HandleCopyAndPaste">
            Copy & Paste
        </MudButton>
    </div>

    <!-- 3. Horizontal Separator Line -->
    <div class="calc-divider"></div>

    <!-- 4. Keypad Grid Principal (4 Coloane x 5 Randuri, patrate, merg pana jos) -->
    <div class="calc-grid-layout">
        <!-- Randul 1: sin / cos | Ans | ⬅ | AC -->
        <MudButton Class="@($"calc-btn {(_activeFlyout == FlyoutType.Trig ? "active" : "")}")"
                   onmousedown="event.preventDefault()"
                   OnClick="() => ToggleFlyout(FlyoutType.Trig)">
            sin / cos
        </MudButton>
        <MudButton Class="calc-btn" onmousedown="event.preventDefault()" OnClick='() => AppendText("Ans")'>
            Ans
        </MudButton>
        <MudButton Class="calc-btn" onmousedown="event.preventDefault()" OnClick="DeleteLast">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Style="font-size: 1.8rem;" />
        </MudButton>
        <MudButton Class="calc-btn calc-btn-clear" onmousedown="event.preventDefault()" OnClick="ClearAll">
            AC
        </MudButton>

        <!-- Randul 2: log | degrees (span 2) | / -->
        <MudButton Class="@($"calc-btn {(_activeFlyout == FlyoutType.Log ? "active" : "")}")"
                   onmousedown="event.preventDefault()"
                   OnClick="() => ToggleFlyout(FlyoutType.Log)">
            log
        </MudButton>
        <MudButton Class="calc-btn calc-btn-span2" onmousedown="event.preventDefault()" OnClick="ToggleDegRad">
            @(_isDegrees ? "degrees" : "radians")
        </MudButton>
        <MudButton Class="calc-btn" onmousedown="event.preventDefault()" OnClick='() => AppendOperator(" / ")'>
            /
        </MudButton>

        <!-- Randul 3: pi / e | ( | ) | X -->
        <MudButton Class="@($"calc-btn {(_activeFlyout == FlyoutType.Constants ? "active" : "")}")"
                   onmousedown="event.preventDefault()"
                   OnClick="() => ToggleFlyout(FlyoutType.Constants)">
            pi / e
        </MudButton>
        <MudButton Class="calc-btn" onmousedown="event.preventDefault()" OnClick='() => AppendText("(")'>
            (
        </MudButton>
        <MudButton Class="calc-btn" onmousedown="event.preventDefault()" OnClick='() => AppendText(")")'>
            )
        </MudButton>
        <MudButton Class="calc-btn" onmousedown="event.preventDefault()" OnClick='() => AppendOperator(" * ")'>
            X
        </MudButton>

        <!-- Randul 4: xʸ | |x| | n! | - -->
        <MudButton Class="@($"calc-btn {(_activeFlyout == FlyoutType.Powers ? "active" : "")}")"
                   onmousedown="event.preventDefault()"
                   OnClick="() => ToggleFlyout(FlyoutType.Powers)">
            xʸ
        </MudButton>
        <MudButton Class="calc-btn" onmousedown="event.preventDefault()" OnClick='() => AppendFunction("abs(")'>
            |x|
        </MudButton>
        <MudButton Class="calc-btn" onmousedown="event.preventDefault()" OnClick='() => AppendText("!")'>
            n!
        </MudButton>
        <MudButton Class="calc-btn" onmousedown="event.preventDefault()" OnClick='() => AppendOperator(" - ")'>
            -
        </MudButton>

        <!-- Randul 5: numpad | +/- | % (Modulo) | + -->
        <MudButton Class="@($"calc-btn {(_activeFlyout == FlyoutType.Numpad ? "active" : "")}")"
                   onmousedown="event.preventDefault()"
                   OnClick="() => ToggleFlyout(FlyoutType.Numpad)">
            numpad
        </MudButton>
        <MudButton Class="calc-btn" onmousedown="event.preventDefault()" OnClick="ToggleSign">
            +/-
        </MudButton>
        <MudButton Class="calc-btn" onmousedown="event.preventDefault()" OnClick='() => AppendOperator(" % ")'>
            %
        </MudButton>
        <MudButton Class="calc-btn" onmousedown="event.preventDefault()" OnClick='() => AppendOperator(" + ")'>
            +
        </MudButton>
    </div>

    <!-- 5. Floating Flyout Panels (fara buton close, butoane patrate) -->
    
    <!-- Flyout 1: Trigonometrie (butoane patrate 85px x 85px) -->
    @if (_activeFlyout == FlyoutType.Trig)
    {
        <div class="calc-flyout-panel" style="top: 140px;">
            <div class="flyout-grid-4col">
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("sin(")'>sin</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("cos(")'>cos</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("tan(")'>tan</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("cot(")'>cot</MudButton>

                <MudButton Class="flyout-btn flyout-btn-smalltext" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("arcsin(")'>arcsin</MudButton>
                <MudButton Class="flyout-btn flyout-btn-smalltext" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("arccos(")'>arccos</MudButton>
                <MudButton Class="flyout-btn flyout-btn-smalltext" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("arctan(")'>arctan</MudButton>
                <MudButton Class="flyout-btn flyout-btn-smalltext" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("arccot(")'>arccot</MudButton>

                <MudButton Class="flyout-btn flyout-btn-smalltext" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("sinh(")'>sinh</MudButton>
                <MudButton Class="flyout-btn flyout-btn-smalltext" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("cosh(")'>cosh</MudButton>
                <MudButton Class="flyout-btn flyout-btn-smalltext" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("tanh(")'>tanh</MudButton>
                <MudButton Class="flyout-btn flyout-btn-smalltext" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("coth(")'>coth</MudButton>
            </div>
        </div>
    }

    <!-- Flyout 2: Log (butoane patrate 85px x 85px) -->
    @if (_activeFlyout == FlyoutType.Log)
    {
        <div class="calc-flyout-panel" style="top: 220px;">
            <div class="flyout-grid-3col">
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("log(")'>log</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("lg(")'>lg</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("ln(")'>ln</MudButton>
            </div>
        </div>
    }

    <!-- Flyout 3: Constante (EXCLUSIV pi si e, Ans STERS) -->
    @if (_activeFlyout == FlyoutType.Constants)
    {
        <div class="calc-flyout-panel" style="top: 290px;">
            <div class="flyout-grid-2col">
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectText("pi")'>pi</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectText("e")'>e</MudButton>
            </div>
        </div>
    }

    <!-- Flyout 4: Puteri si Radicali (butoane patrate 85px x 85px) -->
    @if (_activeFlyout == FlyoutType.Powers)
    {
        <div class="calc-flyout-panel" style="bottom: 14px;">
            <div class="flyout-grid-3col">
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectText("^2")'>x²</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectText("^3")'>x³</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectText("^")'>xⁿ</MudButton>

                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("sqrt(")'>√x</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectFunction("cbrt(")'>∛x</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectText("^(1/")'>ⁿ√x</MudButton>

                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => SelectText("(1/")'>1/x</MudButton>
            </div>
        </div>
    }

    <!-- Flyout 5: Numpad (butoane patrate 85px x 85px) -->
    @if (_activeFlyout == FlyoutType.Numpad)
    {
        <div class="calc-flyout-panel" style="bottom: 14px;">
            <div class="flyout-grid-3col">
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => AppendDigit("7")'>7</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => AppendDigit("8")'>8</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => AppendDigit("9")'>9</MudButton>

                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => AppendDigit("4")'>4</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => AppendDigit("5")'>5</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => AppendDigit("6")'>6</MudButton>

                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => AppendDigit("1")'>1</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => AppendDigit("2")'>2</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick='() => AppendDigit("3")'>3</MudButton>

                <MudButton Class="flyout-btn flyout-btn-span2" onmousedown="event.preventDefault()" OnClick='() => AppendDigit("0")'>0</MudButton>
                <MudButton Class="flyout-btn" onmousedown="event.preventDefault()" OnClick="AppendDot">.</MudButton>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<string> OnPasteResult { get; set; }

    private ElementReference _inputRef;

    private enum FlyoutType
    {
        None,
        Trig,
        Log,
        Constants,
        Powers,
        Numpad
    }

    private FlyoutType _activeFlyout = FlyoutType.None;
    private string _expression = "";
    private string _displayResult = "0";
    private string _lastAns = "0";
    private bool _isDegrees = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(50);
            await FocusInputAsync();
        }
    }

    public async Task FocusInputAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('calc-main-input')?.focus();");
        }
        catch
        {
            try { await _inputRef.FocusAsync(); } catch { }
        }
    }

    private void OnInputTyped(ChangeEventArgs e)
    {
        _expression = e.Value?.ToString() ?? "";
        EvaluateRealTime();
    }

    private void ToggleFlyout(FlyoutType type)
    {
        if (_activeFlyout == type)
            _activeFlyout = FlyoutType.None;
        else
            _activeFlyout = type;
    }

    private async Task SelectFunction(string fn)
    {
        AppendFunction(fn);
        _activeFlyout = FlyoutType.None;
        await FocusInputAsync();
    }

    private async Task SelectText(string txt)
    {
        AppendText(txt);
        _activeFlyout = FlyoutType.None;
        await FocusInputAsync();
    }

    private async Task AppendDigit(string digit)
    {
        _expression += digit;
        EvaluateRealTime();
        await FocusInputAsync();
    }

    private async Task AppendOperator(string op)
    {
        if (string.IsNullOrEmpty(_expression))
        {
            _expression = _displayResult != "0" && _displayResult != "Error" ? _displayResult : "0";
        }
        _expression += op;
        _activeFlyout = FlyoutType.None;
        EvaluateRealTime();
        await FocusInputAsync();
    }

    private void AppendFunction(string fn)
    {
        _expression += fn;
        EvaluateRealTime();
    }

    private void AppendText(string txt)
    {
        if (txt == "Ans")
        {
            _expression += _lastAns;
        }
        else
        {
            _expression += txt;
        }
        EvaluateRealTime();
    }

    private async Task AppendDot()
    {
        if (string.IsNullOrEmpty(_expression))
        {
            _expression = "0.";
        }
        else
        {
            _expression += ".";
        }
        EvaluateRealTime();
        await FocusInputAsync();
    }

    private async Task ClearAll()
    {
        _expression = "";
        _displayResult = "0";
        _activeFlyout = FlyoutType.None;
        await FocusInputAsync();
    }

    private async Task DeleteLast()
    {
        if (!string.IsNullOrEmpty(_expression))
        {
            if (_expression.EndsWith(" "))
            {
                _expression = _expression.TrimEnd();
            }
            if (_expression.Length > 0)
            {
                _expression = _expression.Substring(0, _expression.Length - 1);
            }
        }
        EvaluateRealTime();
        await FocusInputAsync();
    }

    private async Task ToggleSign()
    {
        if (string.IsNullOrEmpty(_expression))
        {
            if (_displayResult != "0" && _displayResult != "Error")
            {
                if (_displayResult.StartsWith("-"))
                    _displayResult = _displayResult.Substring(1);
                else
                    _displayResult = "-" + _displayResult;
            }
            return;
        }

        if (_expression.StartsWith("-"))
            _expression = _expression.Substring(1);
        else
            _expression = "-" + _expression;

        EvaluateRealTime();
        await FocusInputAsync();
    }

    private void ToggleDegRad()
    {
        _isDegrees = !_isDegrees;
        EvaluateRealTime();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleCopyAndPaste();
        }
        else if (e.Key == "Escape")
        {
            await ClearAll();
        }
    }

    private void EvaluateRealTime()
    {
        if (string.IsNullOrWhiteSpace(_expression))
        {
            _displayResult = "0";
            return;
        }

        try
        {
            double val = EvaluateMathString(_expression);
            if (!double.IsNaN(val) && !double.IsInfinity(val))
            {
                val = Math.Round(val, 6);
                _displayResult = val.ToString("G", CultureInfo.InvariantCulture);
                _lastAns = _displayResult;
            }
        }
        catch
        {
            // Pastram rezultatul precedent pana expresia devine valida
        }
    }

    private async Task HandleCopyAndPaste()
    {
        if (_displayResult == "Error" || string.IsNullOrWhiteSpace(_displayResult))
        {
            Snackbar.Add("No valid result to copy.", Severity.Warning);
            return;
        }

        if (OnPasteResult.HasDelegate)
        {
            await OnPasteResult.InvokeAsync(_displayResult);
        }
    }

    private double EvaluateMathString(string input)
    {
        string expr = input.Trim();

        // Operatori vizuali si multiplicare
        expr = expr.Replace("×", "*").Replace("÷", "/");
        expr = Regex.Replace(expr, @"(?<=\d|\))\s*[xX]\s*(?=\d|\(|\w)", " * ");
        expr = Regex.Replace(expr, @"\bpi\b", Math.PI.ToString(CultureInfo.InvariantCulture), RegexOptions.IgnoreCase);
        expr = Regex.Replace(expr, @"\be\b", Math.E.ToString(CultureInfo.InvariantCulture), RegexOptions.IgnoreCase);

        // Factorial (ex: 5! -> factorial)
        expr = Regex.Replace(expr, @"(\d+)\!", m =>
        {
            if (int.TryParse(m.Groups[1].Value, out int n) && n >= 0 && n <= 20)
            {
                long fact = 1;
                for (int i = 2; i <= n; i++) fact *= i;
                return fact.ToString();
            }
            return m.Value;
        });

        // Inchidere automata a parantezelor deschise
        int openParen = expr.Count(c => c == '(');
        int closeParen = expr.Count(c => c == ')');
        if (openParen > closeParen)
        {
            expr += new string(')', openParen - closeParen);
        }

        return ParseExpression(expr);
    }

    private double ParseExpression(string expr)
    {
        int index = 0;

        double ParseTerm()
        {
            double value = ParseFactor();
            while (index < expr.Length)
            {
                char op = expr[index];
                if (op == ' ') { index++; continue; }
                if (op != '+' && op != '-') break;
                index++;
                double next = ParseFactor();
                value = (op == '+') ? value + next : value - next;
            }
            return value;
        }

        double ParseFactor()
        {
            double value = ParsePower();
            while (index < expr.Length)
            {
                char op = expr[index];
                if (op == ' ') { index++; continue; }
                if (op != '*' && op != '/' && op != '%') break;
                index++;
                double next = ParsePower();
                if (op == '*')
                {
                    value = value * next;
                }
                else if (op == '/')
                {
                    value = (next != 0 ? value / next : double.NaN);
                }
                else if (op == '%')
                {
                    // Modulo matematic real (a % b)
                    value = (next != 0 ? value % next : double.NaN);
                }
            }
            return value;
        }

        double ParsePower()
        {
            double value = ParsePrimary();
            while (index < expr.Length)
            {
                char op = expr[index];
                if (op == ' ') { index++; continue; }
                if (op != '^') break;
                index++;
                double next = ParsePrimary();
                value = Math.Pow(value, next);
            }
            return value;
        }

        double ParsePrimary()
        {
            while (index < expr.Length && expr[index] == ' ') index++;
            if (index >= expr.Length) return 0;

            if (expr[index] == '-')
            {
                index++;
                return -ParsePrimary();
            }

            if (expr[index] == '+')
            {
                index++;
                return ParsePrimary();
            }

            if (expr[index] == '(')
            {
                index++;
                double val = ParseTerm();
                if (index < expr.Length && expr[index] == ')') index++;
                return val;
            }

            if (char.IsLetter(expr[index]))
            {
                int start = index;
                while (index < expr.Length && char.IsLetter(expr[index])) index++;
                string funcName = expr.Substring(start, index - start).ToLowerInvariant();

                double arg = ParsePrimary();

                return funcName switch
                {
                    "sin" => _isDegrees ? Math.Sin(arg * Math.PI / 180.0) : Math.Sin(arg),
                    "cos" => _isDegrees ? Math.Cos(arg * Math.PI / 180.0) : Math.Cos(arg),
                    "tan" => _isDegrees ? Math.Tan(arg * Math.PI / 180.0) : Math.Tan(arg),
                    "cot" => _isDegrees ? 1.0 / Math.Tan(arg * Math.PI / 180.0) : 1.0 / Math.Tan(arg),
                    "arcsin" or "asin" => _isDegrees ? Math.Asin(arg) * 180.0 / Math.PI : Math.Asin(arg),
                    "arccos" or "acos" => _isDegrees ? Math.Acos(arg) * 180.0 / Math.PI : Math.Acos(arg),
                    "arctan" or "atan" => _isDegrees ? Math.Atan(arg) * 180.0 / Math.PI : Math.Atan(arg),
                    "arccot" or "acot" => _isDegrees ? (Math.PI / 2.0 - Math.Atan(arg)) * 180.0 / Math.PI : Math.PI / 2.0 - Math.Atan(arg),
                    "sinh" => Math.Sinh(arg),
                    "cosh" => Math.Cosh(arg),
                    "tanh" => Math.Tanh(arg),
                    "coth" => 1.0 / Math.Tanh(arg),
                    "sqrt" => Math.Sqrt(arg),
                    "cbrt" => Math.Cbrt(arg),
                    "ln" => Math.Log(arg),
                    "log" => Math.Log10(arg),
                    "lg" => Math.Log2(arg),
                    "abs" => Math.Abs(arg),
                    _ => arg
                };
            }

            int numStart = index;
            bool hasDot = false;
            while (index < expr.Length && (char.IsDigit(expr[index]) || (expr[index] == '.' && !hasDot)))
            {
                if (expr[index] == '.') hasDot = true;
                index++;
            }

            string numStr = expr.Substring(numStart, index - numStart);
            if (double.TryParse(numStr, NumberStyles.Any, CultureInfo.InvariantCulture, out double result))
            {
                return result;
            }

            return 0;
        }

        return ParseTerm();
    }
}
