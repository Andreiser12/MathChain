@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ApiService ApiService
@inject AppSession Session

<style>
    .btn-add-msg {
        background-color: #005ea6 !important;
        color: #ffffff !important;
        font-size: 1.25rem !important;
        font-weight: 500 !important;
        text-transform: none !important;
        padding: 10px 24px !important;
        border-radius: 0px !important;
    }

    .btn-add-msg:hover {
        background-color: #004e8a !important;
    }

    .msg-card {
        background-color: #005ea6 !important;
        color: #ffffff !important;
        border-radius: 0px !important;
        min-height: 56px;
    }

    .msg-header-row {
        cursor: pointer;
        padding: 14px 20px;
    }

    .msg-title-text {
        font-size: 1.35rem !important;
        font-weight: 500 !important;
        color: #ffffff !important;
    }

    .msg-date-text {
        font-size: 1.15rem !important;
        color: rgba(255, 255, 255, 0.9) !important;
    }

    .btn-delete-msg {
        background-color: #e53935 !important;
        color: #ffffff !important;
        border-radius: 0px !important;
        min-width: 44px !important;
        height: 40px !important;
        padding: 4px 10px !important;
    }

    .btn-delete-msg:hover {
        background-color: #c62828 !important;
    }

    .msg-content-panel {
        background-color: #005ea6 !important;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        padding: 20px 24px;
    }

    .msg-body-text {
        font-size: 1.2rem !important;
        color: #ffffff !important;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    /* Comments Section */
    .comments-section {
        margin-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.2);
        padding-top: 16px;
    }

    .comment-item {
        background-color: rgba(0, 45, 80, 0.45);
        border-left: 3px solid #f5a623;
        padding: 10px 14px;
        margin-bottom: 8px;
    }

    .comment-author {
        font-weight: 600;
        color: #ffffff;
        font-size: 1.05rem;
    }

    .comment-date {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.7);
        margin-left: 8px;
    }

    .comment-text {
        color: rgba(255, 255, 255, 0.95);
        font-size: 1.05rem;
        margin-top: 4px;
    }

    .comment-input .mud-input-slot {
        background-color: #ffffff !important;
        color: #000000 !important;
        padding: 8px 12px !important;
        font-size: 1.05rem !important;
        border-radius: 0px !important;
    }

    .comment-input .mud-input-outlined-border {
        border: none !important;
    }

    .btn-add-comment {
        background-color: #f5a623 !important;
        color: #ffffff !important;
        border-radius: 0px !important;
        text-transform: none !important;
        font-size: 1.05rem !important;
        font-weight: 500 !important;
        height: 40px !important;
        padding: 0 20px !important;
    }

    .btn-add-comment:hover {
        background-color: #d48b13 !important;
    }
</style>

<!-- ACTION BAR -->
<MudStack Row="true" Justify="Justify.FlexStart" Class="my-6">
    <MudButton Variant="Variant.Filled"
               Class="btn-add-msg"
               OnClick="OpenNewMessageDialog">
        + new message
    </MudButton>
</MudStack>

<!-- MESSAGES LIST -->
@if (!_messages.Any())
{
    <MudText Style="color: rgba(255, 255, 255, 0.6); font-size: 1.15rem;" Class="mt-4">
        No announcements posted for this class yet.
    </MudText>
}
else
{
    <MudStack Spacing="3" Class="w-100">
        @foreach (var msg in _messages)
        {
            <MudPaper Elevation="0" Square="true" Class="msg-card w-100">

                <!-- Header Row: [ > / v ] Title - Author | Date | [ Trash Button ] -->
                <div class="msg-header-row d-flex align-center justify-space-between"
                     @onclick="() => msg.IsExpanded = !msg.IsExpanded">

                    <!-- Stânga: Săgeată + Titlu + Autor -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@(msg.IsExpanded ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowForward)"
                                 Style="color: #ffffff;" />

                        <MudText Class="msg-title-text">
                            @(msg.IsExpanded ? $"{msg.Title} - {msg.AuthorName}" : msg.Title)
                        </MudText>
                    </MudStack>

                    <!-- Dreapta: Dată trimitere + Buton Ștergere -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudText Class="msg-date-text">
                            @($"Sent: {msg.CreatedAt:dd.MM.yyyy HH:mm}")
                        </MudText>

                        <div @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Class="btn-delete-msg"
                                           Size="Size.Medium"
                                           OnClick="() => ConfirmDeleteMessage(msg)" />
                        </div>
                    </MudStack>
                </div>

                <!-- Zona expandată (Canva Img 4 + Comentarii) -->
                <MudCollapse Expanded="msg.IsExpanded">
                    <div class="msg-content-panel">

                        <!-- Conținutul mesajului -->
                        <MudText Class="msg-body-text">
                            @msg.Content
                        </MudText>

                        <!-- Secțiunea de comentarii -->
                        <div class="comments-section">
                            <MudText Style="font-size: 1.15rem; font-weight: 500; color: #ffffff;" Class="mb-3">
                                Comments (@msg.Comments.Count)
                            </MudText>

                            @if (msg.Comments.Any())
                            {
                                <MudStack Spacing="2" Class="mb-4">
                                    @foreach (var comment in msg.Comments)
                                    {
                                        <div class="comment-item">
                                            <div class="d-flex align-center">
                                                <span class="comment-author">@comment.AuthorName</span>
                                                <span class="comment-date">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                            </div>
                                            <div class="comment-text">
                                                @comment.Content
                                            </div>
                                        </div>
                                    }
                                </MudStack>
                            }
                            else
                            {
                                <MudText Style="color: rgba(255,255,255,0.6); font-style: italic; font-size: 1rem;" Class="mb-3">
                                    No comments yet. Be the first to comment.
                                </MudText>
                            }

                            <!-- Adăugare comentariu nou -->
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudTextField @bind-Value="msg.NewCommentText"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="comment-input flex-grow-1"
                                              Placeholder="Write a comment..." />

                                <MudButton Variant="Variant.Filled"
                                           Class="btn-add-comment"
                                           OnClick="() => AddComment(msg)">
                                    Comment
                                </MudButton>
                            </MudStack>
                        </div>

                    </div>
                </MudCollapse>

            </MudPaper>
        }
    </MudStack>
}

@code {
    [Parameter]
    public ClassRoomDto? ClassRoom { get; set; }

    [Parameter]
    public string? ClassId { get; set; }

    public class MessageUiItem
    {
        public Guid Id { get; set; }
        public Guid ClassRoomId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public string AuthorWallet { get; set; } = string.Empty;
        public string AuthorName { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public bool IsExpanded { get; set; }
        public string NewCommentText { get; set; } = string.Empty;
        public List<CommentUiItem> Comments { get; set; } = new();
    }

    public class CommentUiItem
    {
        public Guid Id { get; set; }
        public Guid MessageId { get; set; }
        public string AuthorWallet { get; set; } = string.Empty;
        public string AuthorName { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
    }

    private List<MessageUiItem> _messages = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadMessages();
    }

    private async Task LoadMessages()
    {
        if (ClassRoom == null) return;
        var list = await ApiService.GetClassMessagesAsync(ClassRoom.Id);
        _messages = list.Select(m => new MessageUiItem
        {
            Id = m.Id,
            ClassRoomId = m.ClassRoomId,
            Title = m.Title,
            Content = m.Content,
            AuthorWallet = m.AuthorWallet,
            AuthorName = m.AuthorName,
            CreatedAt = m.CreatedAt,
            IsExpanded = false,
            Comments = m.Comments.Select(c => new CommentUiItem
            {
                Id = c.Id,
                MessageId = c.MessageId,
                AuthorWallet = c.AuthorWallet,
                AuthorName = c.AuthorName,
                Content = c.Content,
                CreatedAt = c.CreatedAt
            }).ToList()
        }).ToList();
        StateHasChanged();
    }

    private async Task OpenNewMessageDialog()
    {
        if (ClassRoom == null) return;
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = false
        };
        var dialog = await DialogService.ShowAsync<NewMessageDialog>("", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is NewMessageDialog.MessageResultDto dto)
        {
            string author = Session.WalletAddress ?? "Teacher";
            bool success = await ApiService.CreateClassMessageAsync(ClassRoom.Id, dto.Title, dto.Message, author);
            if (success)
            {
                Snackbar.Add("Announcement posted successfully!", Severity.Success);
                await LoadMessages();
            }
            else
            {
                Snackbar.Add("Failed to post announcement.", Severity.Error);
            }
        }
    }

    private async Task ConfirmDeleteMessage(MessageUiItem msg)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Announcement",
            "Are you sure you want to delete this announcement?",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed == true)
        {
            bool success = await ApiService.DeleteClassMessageAsync(msg.Id);
            if (success)
            {
                _messages.Remove(msg);
                Snackbar.Add("Announcement deleted.", Severity.Info);
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Failed to delete announcement.", Severity.Error);
            }
        }
    }

    private async Task AddComment(MessageUiItem msg)
    {
        if (string.IsNullOrWhiteSpace(msg.NewCommentText))
        {
            Snackbar.Add("Please enter a comment.", Severity.Warning);
            return;
        }
        string author = Session.WalletAddress ?? "User";
        bool success = await ApiService.AddMessageCommentAsync(msg.Id, msg.NewCommentText, author);
        if (success)
        {
            msg.Comments.Add(new CommentUiItem
            {
                Id = Guid.NewGuid(),
                MessageId = msg.Id,
                AuthorWallet = author,
                AuthorName = author.Length > 10 ? $"{author.Substring(0, 6)}...{author.Substring(author.Length - 4)}" : author,
                Content = msg.NewCommentText,
                CreatedAt = DateTime.UtcNow
            });
            msg.NewCommentText = string.Empty;
            Snackbar.Add("Comment added!", Severity.Success);
            StateHasChanged();
        }
        else
        {
            Snackbar.Add("Failed to add comment.", Severity.Error);
        }
    }
}
