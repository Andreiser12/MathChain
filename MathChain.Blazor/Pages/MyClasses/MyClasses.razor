@page "/my-classes"
@inject ApiService Api
@inject AppSession Session
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    * {
        border-radius: 0px !important;
    }

    .sharp-class-card {
        cursor: pointer;
        transition: background-color 0.15s ease-in-out;
        user-select: none;
    }

    .sharp-class-card:hover {
        background-color: #006ec4 !important;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 px-6">
    
    <!-- Topbar: Centered Title + Right Button using MudGrid -->
    <MudGrid Class="align-center mb-10 w-100">
        <MudItem xs="12" sm="3" Class="d-none d-sm-flex"></MudItem>
        
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.h3" Align="Align.Center" Style="color: white; font-weight: 500;">
                My classes
            </MudText>
        </MudItem>

        <MudItem xs="12" sm="3" Class="d-flex justify-sm-end justify-center">
            <MudButton Variant="Variant.Filled"
                       Style="background-color: #005ea6; color: #ffffff; font-size: 1.15rem; font-weight: 500; text-transform: none; padding: 10px 24px; border-radius: 0px;"
                       OnClick="OpenCreateDialog">
                + Create new class
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (_classRooms == null)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </MudStack>
    }
    else if (!_classRooms.Any())
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-12">
            <MudText Typo="Typo.h6" Style="color: rgba(255, 255, 255, 0.6);">
                You haven't created any classes yet.
            </MudText>
        </MudStack>
    }
    else
    {
        <MudGrid Spacing="6">
            @foreach (var classRoom in _classRooms)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Elevation="0" 
                              Square="true" 
                              Class="d-flex align-center justify-center pa-4 sharp-class-card" 
                              Style="background-color: #005ea6; height: 190px; color: #ffffff; border-radius: 0px;"
                              @onclick="() => OpenClass(classRoom)">
                        <MudText Align="Align.Center" Style="font-size: 1.4rem; font-weight: 500; color: #ffffff;">
                            @classRoom.Name
                        </MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code
{
    private List<ClassRoomDto>? _classRooms;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsConnected)
        {
            await Session.RestoreSessionAsync();
        }

        if (!Session.IsConnected)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadClassRooms();
    }

    private async Task LoadClassRooms()
    {
        _classRooms = await Api.GetClassRoomsByTeacherAsync(Session.WalletAddress);
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = false
        };

        var dialog = await DialogService.ShowAsync<CreateClassRoomDialog>("", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadClassRooms();
        }
    }

    private void OpenClass(ClassRoomDto classRoom)
    {
        Nav.NavigateTo($"/class/{classRoom.Id}");
    }
}