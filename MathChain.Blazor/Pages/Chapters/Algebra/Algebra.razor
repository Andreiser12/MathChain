				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="4"
					 Class="cursor-pointer hover-effect"
					 @onclick='() => Nav.NavigateTo("/powers")'>
				<MudCardMedia Image="Assets/Images/Integrals_Image.png"
							  Height="200">
				</MudCardMedia>
				<MudCardContent>
					<MudText Typo="Typo.h6" Align="Align.Center">Powers</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="4"
					 Class="cursor-pointer hover-effect"
