@page "/bijection-functions"
@inject IJSRuntime JS
@inject IDialogService DialogService
@using MathChain.Domain.Entities

<Component />


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
	<MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Bijection</MudText>

	<MudGrid>
		@foreach (var formula in _formulas)
		{
			<MudItem xs="12" sm="6" md="4">
				<MudCard Elevation="4" Class="p-4" Style="background-color: #222222">
					<MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-2"></MudText>

					<div class="formula-card"
						 @onmouseenter="(() => Load3DModel(formula))"
						 @onmouseleave="(() => Unload3DModel(formula))"
						 @ondblclick="(() => OpenFormulaDialog(formula))">
						<div class="formula-2d">
							<span>
								@formula.Latex
							</span>
						</div>

						<div class="formula-3d">
							<canvas id="@($"{formula.Id}-canvas")"></canvas>
						</div>
					</div>
				</MudCard>
			</MudItem>
		}
	</MudGrid>
</MudContainer>



@code
{
	private static readonly string requirement = "";

	private List<Formula> _formulas = new List<Formula>
	{
		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{gather*}
					f:A\to B, \text{ } f(x)=y\\
					A = \text{domain of definition, }x\in A \\
					B = \text{codomain, }y\in B
					\end{gather*}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{gather*}
					f:A\to B\\
					f \text{ is injective if from } f(x_1)=f(x_2) \Rightarrow x_1=x_2 \\
					f \text{ is not injective if } x_1\neq x_2 \text{ such that } f(x_1)=f(x_2) 
					\end{gather*}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{gather*}
					f:A\to B\\
					f \text{ is surjective if the ecuation } f(x)=y \text{ has at least one solution} \\
					f \text{ is not surjective if the ecuation } f(x)=y \text{ does not have solutions}
					\end{gather*}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{gather*}
					f:A\to B\\
					f \text{ is surjective if the ecuation } f(x)=y \text{ has at least one solution} \\
					f \text{ is not surjective if the ecuation } f(x)=y \text{ does not have solutions}
					\end{gather*}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{gather*}
					f:A\to B\\
					f \text{ is bijective if } f\text{ is injective and surjective} \\
					f \text{ is bijective if the ecuation } f(x)=y \text{ has a unique solution}
					\end{gather*}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{gather*}
					f \text{ is invertible if it is bijective and satisfies}  \\ \text{ the property } f(x)=y \Leftrightarrow x=f^{-1}(y)
					\end{gather*}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "",
			Requirement = $"{requirement}"
		},
	};

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await JS.InvokeVoidAsync("formatMath");
			await Task.Delay(200);
			await JS.InvokeVoidAsync("autoScaleFormulas");
		}
	}

	private async Task Load3DModel(Formula formula)
	{
		await JS.InvokeVoidAsync("math3D.loadModel", formula.Id + "-canvas", formula.ModelPath);
	}

	private async Task Unload3DModel(Formula formula)
	{
		await JS.InvokeVoidAsync("math3D.stopModel", formula.Id + "-canvas", formula.ModelPath);
	}

	private async Task OpenFormulaDialog(Formula formula)
	{
		var parameters = new DialogParameters<FormulaDialog>
		{
			{ x => x.Formula, formula},
			{ x => x.TotalFormulas, _formulas.Count  }
		};

		var options = new DialogOptions
		{
			CloseOnEscapeKey = true,
			MaxWidth = MaxWidth.Medium,
			FullWidth = true
		};

		await DialogService.ShowAsync<FormulaDialog>("Formula Details", parameters, options);
	}
}

