@page "/basic-functions"
@inject IJSRuntime JS
@inject IDialogService DialogService
@using MathChain.Domain.Entities

<Component />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
	<MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Basic Functions</MudText>

	<MudGrid>
		@foreach (var formula in _formulas)
		{
			<MudItem xs="12" sm="6" md="4">
				<MudCard Elevation="4" Class="p-4" Style="background-color: #222222">
					<MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-2"></MudText>

					<div class="formula-card"
						 @onmouseenter="(() => Load3DModel(formula))"
						 @onmouseleave="(() => Unload3DModel(formula))"
						 @ondblclick="(() => OpenFormulaDialog(formula))">
						<div class="formula-2d">
							<span>
								@formula.Latex
							</span>
						</div>

						<div class="formula-3d">
							<canvas id="@($"{formula.Id}-canvas")"></canvas>
						</div>
					</div>
				</MudCard>
			</MudItem>
		}
	</MudGrid>
</MudContainer>


@code
{
	private static readonly string requirement = "Calculate the derivative, then evaluate at x = 1.";

	private List<Formula> _formulas = new List<Formula>
	{
		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$a'=0$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Derivatives",
			Description = "The derivative of a constant a is zero.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$x'=1$$",
			ModelPath = "Assets/3DModels/intxlan.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(x^n\right)'=nx^{n-1}$$",
			ModelPath = "Assets/3DModels/int1pex.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(\sqrt{x}\right)'=\frac{1}{2\sqrt{x}}$$",
			ModelPath = "Assets/3DModels/intalax.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(a^x\right)'=a^x\ln{a}$$",
			ModelPath = "Assets/3DModels/intelax.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id =Guid.NewGuid(),
			Latex = @"$$\left(\ln{x}\right)'=\frac{1}{x}$$",
			ModelPath = "Assets/3DModels/int1pexla2minusala2.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(\frac{1}{x}\right)'=-\frac{1}{x^2}$$",
			ModelPath = "Assets/3DModels/int1pexla2plusala2(2).glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(e^x\right)'=e^x$$",
			ModelPath = "Assets/3DModels/int1peradala2minusxla2.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(\sin{x}\right)'=\cos{x}$$",
			ModelPath = "Assets/3DModels/int1peradxla2plusala2.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(\cos{x}\right)'=-\sin{x}$$",
			ModelPath = "Assets/3DModels/int1peradxla2minusala2.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(\tan{x}\right)'=\frac{1}{cos^2{x}}$$",
			ModelPath = "Assets/3DModels/intsinx.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(\cot{x}\right)'=-\frac{1}{sin^2{x}}$$",
			ModelPath = "Assets/3DModels/intcosx.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(\arcsin{x}\right)'=\frac{1}{\sqrt{1-x^2}}$$",
			ModelPath = "Assets/3DModels/inttanx.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(\arccos{x}\right)'=-\frac{1}{\sqrt{1-x^2}}$$",
			ModelPath = "Assets/3DModels/intcotx.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(\arctan{x}\right)'=\frac{1}{x^2+1}$$",
			ModelPath = "Assets/3DModels/int1pecosla2x.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\left(\operatorname{arccot}{x}\right)'=-\frac{1}{x^2+1}$$",
			ModelPath = "Assets/3DModels/int1pesinla2x.glb",
			Category = "Derivatives",
			Requirement = $"{requirement}"
		},
	};

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await JS.InvokeVoidAsync("formatMath");
			await Task.Delay(200);
			await JS.InvokeVoidAsync("autoScaleFormulas");
		}
	}

	private async Task Load3DModel(Formula formula)
	{
		await JS.InvokeVoidAsync("math3D.loadModel", formula.Id + "-canvas", formula.ModelPath);
	}

	private async Task Unload3DModel(Formula formula)
	{
		await JS.InvokeVoidAsync("math3D.stopModel", formula.Id + "-canvas", formula.ModelPath);
	}

	private async Task OpenFormulaDialog(Formula formula)
	{
		var parameters = new DialogParameters<FormulaDialog>
		{
			{ x => x.Formula, formula},
			{ x => x.TotalFormulas, _formulas.Count  }
		};

		var options = new DialogOptions
		{
			CloseOnEscapeKey = true,
			MaxWidth = MaxWidth.Medium,
			FullWidth = true
		};

		await DialogService.ShowAsync<FormulaDialog>("Formula Details", parameters, options);
	}
}