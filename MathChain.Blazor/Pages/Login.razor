@page "/"
@page "/login"
@using MathChain.Domain.Enums
@inject IJSRuntime JS
@inject AppSession Session
@inject NavigationManager Nav
@inject ApiService Api
@inject IDialogService DialogService
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
	<MudPaper Elevation="4" Class="pa-8 d-flex flex-column align-center gap-4" Style="background-color: #16213e; color: #ffffff; border-radius: 8px;">
		<MudText Typo="Typo.h4" Style="font-weight: 600; color: #ffffff;">Connect Wallet</MudText>
		<MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.6); text-align: center;">
			Alege portofelul pentru a te conecta în MathChain
		</MudText>

		<MudStack Spacing="3" Class="w-100 mt-2" Style="max-width: 320px;">
			<MudButton Variant="Variant.Filled"
					   Style="background-color: #f6851b; color: #ffffff; font-weight: 600; text-transform: none; font-size: 1.05rem;"
					   FullWidth="true"
					   Size="Size.Large"
					   StartIcon="@Icons.Material.Filled.AccountBalanceWallet"
					   OnClick='() => ConnectWithWallet("metamask")'>
				Connect MetaMask
			</MudButton>

			<MudButton Variant="Variant.Filled"
					   Style="background-color: #ab9ff2; color: #1a1a2e; font-weight: 600; text-transform: none; font-size: 1.05rem;"
					   FullWidth="true"
					   Size="Size.Large"
					   StartIcon="@Icons.Material.Filled.Token"
					   OnClick='() => ConnectWithWallet("phantom")'>
				Connect Phantom
			</MudButton>
		</MudStack>

		@if (_googleAvailable)
		{
			<MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.6);">or</MudText>
		}

		<div id="@GoogleButtonId"></div>

		@if (!string.IsNullOrEmpty(_address))
		{
			<MudText Typo="Typo.body1"
					 Color="Color.Success" Class="mt-2">
				Connected: @_address[..8]...
			</MudText>
		}

		@if (!string.IsNullOrEmpty(_errorMessage))
		{
			<MudAlert Severity="Severity.Error" Class="mt-2 w-100">@_errorMessage</MudAlert>
		}
	</MudPaper>
</MudContainer>

@code {
	const string GoogleButtonId = "google-signin-button";

	string _address = string.Empty;
	string _errorMessage = string.Empty;
	bool _googleAvailable;
	DotNetObjectReference<Login>? _dotNetReference;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}

		var providers = await Api.GetSignInProvidersAsync();

		if (string.IsNullOrWhiteSpace(providers.GoogleClientId))
		{
			return;
		}

		_dotNetReference = DotNetObjectReference.Create(this);

		try
		{
			_googleAvailable = await JS.InvokeAsync<bool>("renderGoogleSignInButton", GoogleButtonId, providers.GoogleClientId, _dotNetReference);
		}
		catch (JSException renderError)
		{
			Console.WriteLine($"[Login] Rendering the Google button failed: {renderError.Message}");
		}

		StateHasChanged();
	}

	[JSInvokable]
	public async Task OnGoogleCredential(string idToken)
	{
		_errorMessage = string.Empty;

		try
		{
			var result = await Api.SignInWithGoogleAsync(idToken, null);

			if (result.RegistrationRequired)
			{
				var dialog = await DialogService.ShowAsync<ChooseRoleDialog>("Welcome to MathChain!");
				var dialogResult = await dialog.Result;

				if (dialogResult == null || dialogResult.Canceled || dialogResult.Data == null)
				{
					_errorMessage = "You must choose a role to continue.";
					StateHasChanged();
					return;
				}

				result = await Api.SignInWithGoogleAsync(idToken, dialogResult.Data.ToString());
			}

			if (result.Auth == null)
			{
				_errorMessage = result.Error ?? "Google sign-in could not be completed. Please try again.";
				StateHasChanged();
				return;
			}

			var user = result.Auth.User;
			_address = user.WalletAddress;

			await Session.SetSessionAsync(user.WalletAddress, user.Role, result.Auth.Token, result.Auth.ExpiresAt);

			Nav.NavigateTo(user.Role == UserRole.Teacher ? "/my-classes" : "/chapters");
		}
		catch (HttpRequestException httpError)
		{
			Console.WriteLine($"[Login] Google sign-in request failed: {httpError.Message}");
			_errorMessage = "The server could not be reached. Make sure the API is running.";
			StateHasChanged();
		}
		catch (Exception error)
		{
			Console.WriteLine($"[Login] Google sign-in failed: {error.Message}");
			_errorMessage = $"Google sign-in failed: {error.Message}";
			StateHasChanged();
		}
	}

	public void Dispose()
	{
		_dotNetReference?.Dispose();
	}

	protected override async Task OnInitializedAsync()
	{
		if (!Session.IsConnected)
		{
			await Session.RestoreSessionAsync();
		}

		if (Session.IsConnected)
		{
			if (Session.Role == UserRole.Teacher)
			{
				Nav.NavigateTo("/my-classes");
			}
			else
			{
				Nav.NavigateTo("/chapters");
			}
		}
	}

	async Task ConnectWithWallet(string walletType)
	{
		_errorMessage = string.Empty;

		try
		{
			string jsMethod = walletType == "phantom" ? "connectPhantom" : "connectMetaMask";
			_address = await JS.InvokeAsync<string>(jsMethod);

			if (string.IsNullOrEmpty(_address))
			{
				string walletName = walletType == "phantom" ? "Phantom" : "MetaMask";
				_errorMessage = $"Conexiunea cu {walletName} nu a fost confirmată. Verifică popup-ul extensiei (sau dacă portofelul este deblocat) și încearcă din nou.";
				return;
			}

			var userExists = await Api.CheckUserExistsAsync(_address);
			string? chosenRole = null;

			if (!userExists)
			{
				var dialog = await DialogService.ShowAsync<ChooseRoleDialog>("Welcome to MathChain!");
				var result = await dialog.Result;

				if (result == null || result.Canceled || result.Data == null)
				{
					_errorMessage = "Trebuie să selectezi un rol pentru a continua.";
					return;
				}

				chosenRole = result.Data.ToString();
			}

			long chainId;

			try
			{
				chainId = await JS.InvokeAsync<long>("getWalletChainId");
			}
			catch (JSException chainError)
			{
				Console.WriteLine($"[Login] Reading the wallet network failed: {chainError.Message}");
				_errorMessage = $"Could not read the wallet network: {chainError.Message}";
				return;
			}

			var challenge = await Api.RequestLoginChallengeAsync(_address, chainId);

			if (challenge == null)
			{
				_errorMessage = "Could not start the login. Please try again.";
				return;
			}

			string signature;

			try
			{
				signature = await JS.InvokeAsync<string>("signLoginMessage", _address, challenge.Message);
			}
			catch (JSException signError)
			{
				Console.WriteLine($"[Login] Signing the login message failed: {signError.Message}");
				_errorMessage = $"The login message was not signed: {signError.Message}";
				return;
			}

			var auth = await Api.VerifyLoginAsync(_address, signature, chosenRole);

			if (auth == null)
			{
				_errorMessage = "Nu s-a putut finaliza autentificarea. Te rugăm să încerci din nou.";
				return;
			}

			var user = auth.User;

			await Session.SetSessionAsync(_address, user.Role, auth.Token, auth.ExpiresAt);

			if (user.Role == UserRole.Teacher)
			{
				Nav.NavigateTo("/my-classes");
			}
			else
			{
				Nav.NavigateTo("/chapters");
			}
		}
		catch (JSException jsEx)
		{
			_errorMessage = $"Eroare JavaScript la conectare: {jsEx.Message}";
			Console.WriteLine($"JSException: {jsEx.Message}");
		}
		catch (HttpRequestException httpEx)
		{
			_errorMessage = $"Eroare API Server ({httpEx.StatusCode}): Asigură-te că backend-ul rulează.";
			Console.WriteLine($"HttpRequestException: {httpEx.Message}");
		}
		catch (Exception ex)
		{
			_errorMessage = $"A apărut o eroare la autentificare: {ex.Message}";
			Console.WriteLine($"Exception: {ex.Message}");
		}
	}
}
