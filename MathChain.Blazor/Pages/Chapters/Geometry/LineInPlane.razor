		{
			Id = Guid.NewGuid(),
			Latex = @"$$\text{Two lines are parallel}\Leftrightarrow \text{they have equal slopes}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\text{Two lines $d_1,\, d_2$ are perpendicular}\Leftrightarrow m_1\cdot m_2=-1$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					&\text{The distance between the point }A(x_A,y_A)\text{ and}\\
					&\text{the line }d:ax+by+c=0 \text{ is }d(A,d)=\frac{|ax_A+by_A+c|}{\sqrt{a^2+b^2}} 
					\end{aligned}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
