@page "/line-in-plane"
@inject IJSRuntime JS
@inject IDialogService DialogService
@using MathChain.Domain.Entities

<Component />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
	<MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Line in Plane</MudText>

	<MudGrid>
		@foreach (var formula in _formulas)
		{
			<MudItem xs="12" sm="6" md="4">
				<MudCard Elevation="4" Class="p-4" Style="background-color: #222222">
					<MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-2"></MudText>

					<div class="formula-card"
						 @onmouseenter="(() => Load3DModel(formula))"
						 @onmouseleave="(() => Unload3DModel(formula))"
						 @ondblclick="(() => OpenFormulaDialog(formula))">
						<div class="formula-2d">
							<span>
								@formula.Latex
							</span>
						</div>

						<div class="formula-3d">
							<canvas id="@($"{formula.Id}-canvas")"></canvas>
						</div>
					</div>
				</MudCard>
			</MudItem>
		}
	</MudGrid>
</MudContainer>



@code
{
	private static readonly string requirement = "Calculate the primitive, then evaluate at x = 1 and C = 0.";

	private List<Formula> _formulas = new List<Formula>
	{
		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\text{The general equation of a line is }d:ax+by+c=0$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					&\text{The line that passes through the point }A(x_A,y_A)\\
					&\text{ and has the given slope }m \text { has the equation }d:y-y_A=m(x-x_A)
					\end{aligned}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					&\text{The line that passes through the points }A(x_A,y_A)\text{ and }B(x_B,y_B)\\
					&\text {has the equation }\frac{x-x_A}{x_B-x_A}=\frac{y-y_A}{y_B-y_A}
					\end{aligned}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					&\text{The line that passes through the points }\\
					&A(x_A,y_A)\text{ and }B(x_B,y_B)\text{ is }m_{AB}=\frac{y_B-y_A}{x_B-x_A}\\
					\end{aligned}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					&\text{The line that passes through the points }\\
					&A(x_A,y_A)\text{ and }B(x_B,y_B)\text{ is }m_{AB}=\frac{y_B-y_A}{x_B-x_A}\\
					\end{aligned}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					&\text{If the line }d\text{ has the equation }d:y=mx+n,\\
					&\text{then }m \text{ is the slope of the line }d
					\end{aligned}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					&\text{If the line }d\text{ has the equation }d:ax+by+c=0,\\
