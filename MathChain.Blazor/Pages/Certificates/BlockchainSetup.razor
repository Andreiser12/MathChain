@page "/blockchain"
@using MathChain.Domain.Enums
@inject ApiService Api
@inject FeatureSettings Features
@inject AppSession Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
	<MudText Typo="Typo.h4" Style="color: #ffffff; font-weight: 600;" Class="mb-6">Blockchain setup</MudText>

	@if (Features.Certificates)
	{
		@if (_loading)
		{
			<MudProgressCircular Indeterminate="true" Color="Color.Primary" />
		}
		else if (_setup == null)
		{
			<MudAlert Severity="Severity.Error">@_error</MudAlert>
		}
		else
		{
			<MudPaper Elevation="2" Class="pa-6" Style="background-color: #16213e; color: #ffffff;">
				<MudStack Spacing="3">
					<div>
						<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.6);">Network</MudText>
						<MudText Typo="Typo.body1">@_setup.NetworkName (chain @_setup.ChainId)</MudText>
					</div>
					<div>
						<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.6);">Certificates contract</MudText>
						<MudText Typo="Typo.body1" Style="word-break: break-all;">@_setup.ContractAddress</MudText>
					</div>

					@if (!_setup.CanIssue)
					{
						<MudAlert Severity="Severity.Warning" id="setup-status">
							The issuer key is not configured. Set Blockchain:IssuerPrivateKey with dotnet user-secrets and restart the API.
						</MudAlert>
					}
					else
					{
						<div>
							<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.6);">Platform issuer account</MudText>
							<MudText Typo="Typo.body1" Style="word-break: break-all;" id="issuer-address">@_setup.IssuerAddress</MudText>
						</div>
						<div>
							<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.6);">Issuer balance</MudText>
							<MudText Typo="Typo.body1" id="issuer-balance">@_setup.IssuerBalance.ToString("0.000000") ETH</MudText>
						</div>

						@if (_setup.HasIssuerRole && _setup.IssuerBalance > 0)
						{
							<MudAlert Severity="Severity.Success" id="setup-status">The platform can issue certificates.</MudAlert>
						}
						else
						{
							<MudAlert Severity="Severity.Warning" id="setup-status">
								@(_setup.HasIssuerRole
									? "The issuer account has the issuer role but no funds to pay for transactions."
									: "The issuer account does not have the issuer role yet.")
							</MudAlert>
						}

						<MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.7);">
							Both actions below open your wallet. Sign them with the account that is the admin of the contract.
						</MudText>

						<MudStack Row="true" Spacing="3">
							<MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform: none;"
									   Disabled="@(_setup.HasIssuerRole || _busy)" OnClick="GrantIssuerRole">
								Grant issuer role
							</MudButton>
							<MudButton Variant="Variant.Outlined" Color="Color.Primary" Style="text-transform: none;"
									   Disabled="_busy" OnClick="FundIssuer">
								Send @FundingAmountText ETH to the issuer
							</MudButton>
							<MudButton Variant="Variant.Text" Color="Color.Primary" Style="text-transform: none;"
									   Disabled="_busy" OnClick="Reload">
								Refresh
							</MudButton>
						</MudStack>
					}

					@if (!string.IsNullOrEmpty(_lastTransaction))
					{
						<MudText Typo="Typo.body2" Style="word-break: break-all;" id="last-transaction">Transaction sent: @_lastTransaction</MudText>
					}

					@if (!string.IsNullOrEmpty(_actionError))
					{
						<MudAlert Severity="Severity.Error" id="action-error">@_actionError</MudAlert>
					}
				</MudStack>
			</MudPaper>
		}
	}

	@if (!_loading)
	{
		<MudText Typo="Typo.h5" Style="color: #ffffff; font-weight: 600;" Class="mt-8 mb-4">Paid solutions</MudText>

		<MudPaper Elevation="2" Class="pa-6" Style="background-color: #16213e; color: #ffffff;" id="solution-setup">
			@if (_solutionSetup == null)
			{
				<MudAlert Severity="Severity.Error">@_solutionError</MudAlert>
			}
			else if (!_solutionSetup.CanRead)
			{
				<MudAlert Severity="Severity.Warning" id="solution-setup-status">
					Paid solutions are not configured. Set Blockchain:SolutionsAddress and Blockchain:PaymentTokenAddress and restart the API.
				</MudAlert>
			}
			else
			{
				<MudStack Spacing="3">
					<div>
						<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.6);">Solutions contract</MudText>
						<MudText Typo="Typo.body1" Style="word-break: break-all;">@_solutionSetup.ContractAddress</MudText>
					</div>
					<div>
						<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.6);">Payment token</MudText>
						<MudText Typo="Typo.body1" Style="word-break: break-all;">@_solutionSetup.TokenSymbol (@_solutionSetup.TokenAddress)</MudText>
					</div>

					@if (!_solutionSetup.CanRelay)
					{
						<MudAlert Severity="Severity.Warning" id="solution-setup-status">
							The platform key is not configured, so payments cannot be sent. Set Blockchain:IssuerPrivateKey and restart the API.
						</MudAlert>
					}
					else
					{
						<div>
							<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.6);">Platform account that pays the network fees</MudText>
							<MudText Typo="Typo.body1" Style="word-break: break-all;">
								@_solutionSetup.RelayerAddress (@(_solutionSetup.RelayerBalance?.ToString("0.000000")) ETH)
							</MudText>
						</div>
					}

					<MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.7);">
						Prices are stored in the contract. Saving a price opens your wallet; sign it with the admin account of the contract.
					</MudText>

					@foreach (var difficulty in Difficulties)
					{
						var current = CurrentPrice(difficulty);
						<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
							<MudText Typo="Typo.body1" Style="width: 90px;">@difficulty</MudText>
							<div style="width: 200px; flex-shrink: 0;">
								<MudNumericField T="decimal" Value="@_prices[difficulty]" ValueChanged="@(value => _prices[difficulty] = value)"
												 Min="0" Step="0.5m" Format="0.######" Variant="Variant.Outlined" Margin="Margin.Dense"
												 Adornment="Adornment.End" AdornmentText="@_solutionSetup.TokenSymbol"
												 id="@($"price-{difficulty.ToLowerInvariant()}")" />
							</div>
							<MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform: none;"
									   Disabled="@(_busy || current == _prices[difficulty])" OnClick="@(() => SavePriceAsync(difficulty))"
									   id="@($"save-price-{difficulty.ToLowerInvariant()}")">
								Save
							</MudButton>
							<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.6);">
								Current: @(current?.ToString("0.######")) @_solutionSetup.TokenSymbol
							</MudText>
						</MudStack>
					}

					@if (!string.IsNullOrEmpty(_priceTransaction))
					{
						<MudText Typo="Typo.body2" Style="word-break: break-all;" id="price-transaction">Transaction sent: @_priceTransaction</MudText>
					}

					@if (!string.IsNullOrEmpty(_priceError))
					{
						<MudAlert Severity="Severity.Error" id="price-error">@_priceError</MudAlert>
					}
				</MudStack>
			}
		</MudPaper>
	}
</MudContainer>

@code {
	private const string FundingAmountText = "0.005";
	private const string FundingAmountHex = "0x11c37937e08000";
	private const int RefreshAttempts = 10;
	private const int RefreshDelayMilliseconds = 3000;

	private static readonly string[] Difficulties = { "Easy", "Medium", "Hard" };

	private CertificateSetupDto? _setup;
	private SolutionPaymentSetupDto? _solutionSetup;
	private string? _solutionError;
	private string? _priceError;
	private string? _priceTransaction;
	private readonly Dictionary<string, decimal> _prices = new() { ["Easy"] = 0, ["Medium"] = 0, ["Hard"] = 0 };
	private string? _error;
	private string? _actionError;
	private string? _lastTransaction;
	private bool _loading = true;
	private bool _busy;

	protected override async Task OnInitializedAsync()
	{
		if (!Session.IsConnected)
		{
			await Session.RestoreSessionAsync();
		}

		if (!Session.IsConnected)
		{
			Nav.NavigateTo("/login");
			return;
		}

		if (Session.Role != UserRole.Admin)
		{
			Nav.NavigateTo("/chapters");
			return;
		}

		await Reload();
	}

	private async Task Reload()
	{
		if (Features.Certificates)
		{
			var result = await Api.GetCertificateSetupAsync();

			_setup = result.Data;
			_error = result.Error;
		}

		await ReloadSolutionSetupAsync();
		_loading = false;
	}

	private async Task ReloadSolutionSetupAsync()
	{
		var result = await Api.GetSolutionSetupAsync();

		_solutionSetup = result.Data;
		_solutionError = result.Error ?? "The paid solutions setup could not be loaded.";

		if (_solutionSetup != null)
		{
			foreach (var difficulty in Difficulties)
			{
				_prices[difficulty] = CurrentPrice(difficulty) ?? 0;
			}
		}
	}

	private decimal? CurrentPrice(string difficulty)
	{
		return difficulty switch
		{
			"Easy" => _solutionSetup?.EasyPrice,
			"Medium" => _solutionSetup?.MediumPrice,
			_ => _solutionSetup?.HardPrice
		};
	}

	private async Task SavePriceAsync(string difficulty)
	{
		var price = _prices[difficulty];
		_busy = true;
		_priceError = null;
		_priceTransaction = null;
		StateHasChanged();

		var change = await Api.BuildSolutionPriceChangeAsync(difficulty, price);

		if (!change.Success || change.Data == null)
		{
			_priceError = change.Error ?? "The price change could not be prepared.";
			_busy = false;
			return;
		}

		try
		{
			_priceTransaction = await JS.InvokeAsync<string>("sendWalletTransaction", new
			{
				chainId = _solutionSetup!.ChainId,
				networkName = _solutionSetup.NetworkName,
				rpcUrl = _solutionSetup.RpcUrl,
				explorerUrl = _solutionSetup.ExplorerUrl
			}, change.Data.To, change.Data.Data, "0x0");
			StateHasChanged();

			for (var attempt = 0; attempt < RefreshAttempts; attempt++)
			{
				await Task.Delay(RefreshDelayMilliseconds);
				var refreshed = await Api.GetSolutionSetupAsync();

				if (refreshed.Data != null)
				{
					_solutionSetup = refreshed.Data;
				}

				if (CurrentPrice(difficulty) == price)
				{
					Snackbar.Add($"The {difficulty.ToLowerInvariant()} price is now {price:0.######} {_solutionSetup.TokenSymbol}.", Severity.Success);
					break;
				}
			}
		}
		catch (JSException walletError)
		{
			_priceError = $"The wallet did not send the transaction: {walletError.Message}";
		}

		_busy = false;
		StateHasChanged();
	}

	private Task GrantIssuerRole()
	{
		return SendAsync(_setup!.ContractAddress, _setup.GrantIssuerRoleCallData!, "0x0", setup => setup.HasIssuerRole);
	}

	private Task FundIssuer()
	{
		var balanceBefore = _setup!.IssuerBalance;

		return SendAsync(_setup.IssuerAddress!, "0x", FundingAmountHex, setup => setup.IssuerBalance > balanceBefore);
	}

	private async Task SendAsync(string to, string data, string valueHex, Func<CertificateSetupDto, bool> isDone)
	{
		_busy = true;
		_actionError = null;
		_lastTransaction = null;
		StateHasChanged();

		try
		{
			_lastTransaction = await JS.InvokeAsync<string>("sendWalletTransaction", new
			{
				chainId = _setup!.ChainId,
				networkName = _setup.NetworkName,
				rpcUrl = _setup.RpcUrl,
				explorerUrl = _setup.ExplorerUrl
			}, to, data, valueHex);
			StateHasChanged();

			for (var attempt = 0; attempt < RefreshAttempts; attempt++)
			{
				await Task.Delay(RefreshDelayMilliseconds);
				await Reload();

				if (_setup != null && isDone(_setup))
				{
					Snackbar.Add("The transaction was confirmed.", Severity.Success);
					break;
				}
			}
		}
		catch (JSException walletError)
		{
			_actionError = $"The wallet did not send the transaction: {walletError.Message}";
		}

		_busy = false;
		StateHasChanged();
	}
}
