@page "/xoy-plane"
@inject IJSRuntime JS
@inject IDialogService DialogService
@using MathChain.Domain.Entities

<Component />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
	<MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">xOy Plane</MudText>

	<MudGrid>
		@foreach (var formula in _formulas)
		{
			<MudItem xs="12" sm="6" md="4">
				<MudCard Elevation="4" Class="p-4" Style="background-color: #222222">
					<MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-2"></MudText>

					<div class="formula-card"
						 @onmouseenter="(() => Load3DModel(formula))"
						 @onmouseleave="(() => Unload3DModel(formula))"
						 @ondblclick="(() => OpenFormulaDialog(formula))">
						<div class="formula-2d">
							<span>
								@formula.Latex
							</span>
						</div>

						<div class="formula-3d">
							<canvas id="@($"{formula.Id}-canvas")"></canvas>
						</div>
					</div>
				</MudCard>
			</MudItem>
		}
	</MudGrid>
</MudContainer>



@code
{
	private static readonly string requirement = "Calculate the primitive, then evaluate at x = 1 and C = 0.";

	private List<Formula> _formulas = new List<Formula>
	{
		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\text{A vector }\overrightarrow{u}=x\overrightarrow{i}+y\overrightarrow{j}\text{ has the coordinates } (x,y)$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$|\overrightarrow{u}|=\sqrt{x^2+y^2}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					&\overrightarrow{u}=x\overrightarrow{i}+y\overrightarrow{j},\,\overrightarrow{v}=z\overrightarrow{i}+t\overrightarrow{j}\\
					&\overrightarrow{u}=\overrightarrow{v}\Leftrightarrow x=z,\,y=t
					\end{aligned}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					&\overrightarrow{u}\cdot \overrightarrow{v}=x\cdot z+y\cdot t\\
					&\overrightarrow{u}\cdot \overrightarrow{v}=|\overrightarrow{u}|\cdot |\overrightarrow{v}|\cdot \cos{(\overrightarrow{u},\overrightarrow{v})}\\
					&(\overrightarrow{u},\overrightarrow{v})<\frac{\pi}{2}\Leftrightarrow \cos{(\overrightarrow{u},\overrightarrow{v})}>0\\
					&(\overrightarrow{u},\overrightarrow{v})>\frac{\pi}{2}\Leftrightarrow \cos{(\overrightarrow{u},\overrightarrow{v})}<0
					\end{aligned}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\overrightarrow{u}\cdot \overrightarrow{v}=0 \Leftrightarrow \overrightarrow{u}\text{ is perpendicular to }\overrightarrow{v}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\overrightarrow{u}\text{ is parallel to }\overrightarrow{v}\Leftrightarrow \frac{x}{z}=\frac{y}{t}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\begin{aligned}
					&\text{The position vector of the vector}\\
					&A(x_A,y_A)\in xOy\text{ is }\overrightarrow{r_A}=x_A\overrightarrow{i}+y_A\overrightarrow{j}
					\end{aligned}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},

		new Formula
		{
			Id = Guid.NewGuid(),
			Latex = @"$$\text{For two points }A,\,B\in xOy \Rightarrow \overrightarrow{AB}=(x_B-x_A)\overrightarrow{i}+(y_B-y_A)\overrightarrow{j}$$",
			ModelPath = "Assets/3DModels/inta.glb",
			Category = "Integrals",
			Description = "The integral of a constant a is the (constant * x), plus the constant of integration C.",
			Requirement = $"{requirement}"
		},
	};

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await JS.InvokeVoidAsync("formatMath");
			await Task.Delay(200);
			await JS.InvokeVoidAsync("autoScaleFormulas");
		}
	}

	private async Task Load3DModel(Formula formula)
	{
		await JS.InvokeVoidAsync("math3D.loadModel", formula.Id + "-canvas", formula.ModelPath);
	}

	private async Task Unload3DModel(Formula formula)
	{
		await JS.InvokeVoidAsync("math3D.stopModel", formula.Id + "-canvas", formula.ModelPath);
	}

	private async Task OpenFormulaDialog(Formula formula)
	{
		var parameters = new DialogParameters<FormulaDialog>
		{
			{ x => x.Formula, formula},
			{ x => x.TotalFormulas, _formulas.Count  }
		};

		var options = new DialogOptions
		{
			CloseOnEscapeKey = true,
			MaxWidth = MaxWidth.Medium,
			FullWidth = true
		};

		await DialogService.ShowAsync<FormulaDialog>("Formula Details", parameters, options);
	}
}
