@page "/account"
@using MathChain.Domain.Enums
@using MathChain.Domain.Entities
@using MathChain.Blazor.DTOs
@using MudBlazor
@inject AppSession Session
@inject ApiService Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Account - MathChain</PageTitle>

<style>
	.account-container {
		padding-top: 16px !important;
		padding-bottom: 20px !important;
		min-height: calc(100vh - var(--mud-appbar-height, 64px));
		box-sizing: border-box;
		width: 100% !important;
	}

	.account-grid {
		min-height: calc(100vh - var(--mud-appbar-height, 64px) - 36px);
		width: 100% !important;
		margin: 0 !important;
	}

	.account-card {
		background-color: #005ea6 !important;
		border-radius: 0px !important;
		border: none !important;
		box-shadow: none !important;
		color: #ffffff !important;
		width: 100% !important;
	}

	.account-info-box {
		background-color: rgba(0, 0, 0, 0.18);
		border: 1px solid rgba(255, 255, 255, 0.12);
		padding: 12px 16px;
	}

	.chapter-badge-box {
		background-color: rgba(0, 0, 0, 0.18);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 0px !important;
		padding: 14px 16px;
		transition: all 0.2s ease;
	}

	.chapter-badge-box:hover {
		background-color: rgba(0, 0, 0, 0.26);
		border-color: rgba(0, 229, 255, 0.35);
	}

	@@media (max-width: 959px) {
		.account-container {
			min-height: auto;
			padding-bottom: 32px !important;
		}

		.account-grid {
			min-height: auto;
		}
	}
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="account-container px-6">
	<MudGrid Spacing="4" Class="account-grid">
		<!-- LEFT COLUMN: Account Profile (50% Width) -->
		<MudItem xs="12" md="6" lg="6" Class="d-flex pa-2">
			<MudPaper Elevation="0"
					  Square="true"
					  Class="account-card pa-6 w-100 d-flex flex-column justify-space-between">

				<div>
					<!-- Card Header -->
					<div class="card-header pb-3 mb-4 text-center" style="border-bottom: 2px solid rgba(255, 255, 255, 0.2);">
						<MudText Typo="Typo.h4" Style="font-weight: 500; color: #ffffff; letter-spacing: 0.5px;">
							Account Profile
						</MudText>
					</div>

					<!-- User Header with Avatar & Role -->
					<div class="d-flex align-center gap-4 mb-6">
						<MudAvatar Color="Color.Dark" Size="Size.Large" Style="width: 64px; height: 64px; background-color: rgba(0, 0, 0, 0.3); border: 2px solid #00e5ff;">
							<MudIcon Icon="@(Session.Role == UserRole.Admin ? Icons.Material.Filled.AdminPanelSettings : Session.Role == UserRole.Teacher ? Icons.Material.Filled.School : Icons.Material.Filled.Person)"
									 Size="Size.Large"
									 Style="color: #00e5ff;" />
						</MudAvatar>

						<div class="d-flex flex-column">
							<div class="d-flex align-center gap-2">
								<MudText Typo="Typo.h5" Style="font-weight: 600; color: #ffffff;">
									@GetRoleTitle()
								</MudText>
								<MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="background-color: #00e5ff; color: #002b4d; font-weight: 700; height: 22px;">
									@Session.Role.ToString().ToUpper()
								</MudChip>
							</div>
							<div class="d-flex align-center gap-2 mt-1">
								<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color: #69f0ae; font-size: 1rem;" />
								<MudText Typo="Typo.caption" Style="color: #69f0ae; font-weight: 500;">
									MetaMask Connected
								</MudText>
							</div>
						</div>
					</div>

					<MudStack Spacing="4">
						<!-- Wallet Address -->
						<div>
							<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.75); font-weight: 600; letter-spacing: 0.5px;">
								WALLET ADDRESS
							</MudText>
							<div class="account-info-box d-flex align-center justify-space-between mt-1">
								<MudText Style="font-family: monospace; font-size: 1rem; color: #ffffff; word-break: break-all;">
									@Session.WalletAddress
								</MudText>
								<MudTooltip Text="Copy address">
									<MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
												   Size="Size.Medium"
												   Style="color: #00e5ff;"
												   OnClick="CopyAddress" />
								</MudTooltip>
							</div>
						</div>

						<!-- Wallet Balance -->
						<div>
							<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.75); font-weight: 600; letter-spacing: 0.5px;">
								WALLET BALANCE
							</MudText>
							<div class="account-info-box mt-1">
								<MudText Typo="Typo.h5" Style="color: #00e5ff; font-weight: 700; font-family: monospace;">
									@_walletBalance.ToString("0.0000") ETH
								</MudText>
							</div>
						</div>

						<!-- Account Registration Info -->
						<div>
							<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.75); font-weight: 600; letter-spacing: 0.5px;">
								MEMBER SINCE
							</MudText>
							<div class="account-info-box mt-1">
								<MudText Typo="Typo.body1" Style="color: #ffffff;">
									@_createdAt.ToString("dd MMMM yyyy")
								</MudText>
							</div>
						</div>

						<!-- Chapter Badges Progress Overview -->
						<div>
							<div class="d-flex align-center justify-space-between">
								<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.75); font-weight: 600; letter-spacing: 0.5px;">
									CHAPTER BADGES
								</MudText>
								<MudText Typo="Typo.caption" Style="color: #00e5ff; font-weight: 600;">
									@GetEarnedBadgesCount() / @_rootChapters.Count Earned
								</MudText>
							</div>
							<MudProgressLinear Value="@GetEarnedBadgesCount()" Max="@Math.Max(1, _rootChapters.Count)" Color="Color.Info" Class="my-2" Style="height: 8px; border-radius: 0px;" />
						</div>
					</MudStack>
				</div>

				<!-- Footer Action: Disconnect Only -->
				<div class="pt-4 mt-6 d-flex align-center justify-end" style="border-top: 1px solid rgba(255, 255, 255, 0.15);">
					<MudButton Variant="Variant.Filled"
							   Style="background-color: #b71c1c; color: #ffffff; text-transform: none; font-weight: 600; border-radius: 0px; padding: 8px 24px;"
							   StartIcon="@Icons.Material.Filled.Logout"
							   OnClick="Disconnect">
						Disconnect Wallet
					</MudButton>
				</div>
			</MudPaper>
		</MudItem>

		<!-- RIGHT COLUMN: Chapter Badges (50% Width) -->
		<MudItem xs="12" md="6" lg="6" Class="d-flex pa-2">
			<MudPaper Elevation="0"
					  Square="true"
					  Class="account-card pa-6 w-100 d-flex flex-column justify-start">

				<!-- Card Header -->
				<div class="card-header pb-3 mb-4 text-center" style="border-bottom: 2px solid rgba(255, 255, 255, 0.2);">
					<MudText Typo="Typo.h4" Style="font-weight: 500; color: #ffffff; letter-spacing: 0.5px;">
						Chapter Badges
					</MudText>
				</div>

				<!-- Badges Grid from Real DB Chapters -->
				@if (_isLoadingChapters)
				{
					<div class="d-flex justify-center align-center py-12 flex-grow-1">
						<MudProgressCircular Indeterminate="true" Color="Color.Info" Size="Size.Large" />
					</div>
				}
				else
				{
					<MudGrid Spacing="3" Class="mt-1">
						@foreach (var chapter in _rootChapters)
						{
							var totalSubs = GetTotalSubchapters(chapter);
							var totalFormulas = GetTotalFormulas(chapter);
							var completedSubs = GetCompletedSubchapters(chapter);
							var completedFormulas = GetCompletedFormulas(chapter);
							var isCompleted = totalSubs > 0 && completedSubs >= totalSubs && totalFormulas > 0 && completedFormulas >= totalFormulas;

							<MudItem xs="12" sm="6">
								<div class="chapter-badge-box d-flex flex-column justify-space-between h-100">
									<!-- Title and Lock/Check Icon -->
									<div class="d-flex align-center justify-space-between mb-3">
										<MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #ffffff;">
											@chapter.Title
										</MudText>
										@if (isCompleted)
										{
											<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="color: #69f0ae;" />
										}
										else
										{
											<MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="color: rgba(255, 255, 255, 0.4);" />
										}
									</div>

									<!-- Real Progress Bars -->
									<div class="d-flex flex-column gap-3 mb-3">
										<!-- Subchapters Progress -->
										<div>
											<div class="d-flex align-center justify-space-between mb-1">
												<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.75); font-weight: 500;">
													Subchapters
												</MudText>
												<MudText Typo="Typo.caption" Style="color: #00e5ff; font-weight: 600; font-family: monospace;">
													@completedSubs / @totalSubs
												</MudText>
											</div>
											<MudProgressLinear Value="@completedSubs"
															   Max="@Math.Max(1, totalSubs)"
															   Color="Color.Info"
															   Style="height: 6px; border-radius: 0px;" />
										</div>

										<!-- Formulas Progress -->
										<div>
											<div class="d-flex align-center justify-space-between mb-1">
												<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.75); font-weight: 500;">
													Formulas
												</MudText>
												<MudText Typo="Typo.caption" Style="color: #69f0ae; font-weight: 600; font-family: monospace;">
													@completedFormulas / @totalFormulas
												</MudText>
											</div>
											<MudProgressLinear Value="@completedFormulas"
															   Max="@Math.Max(1, totalFormulas)"
															   Color="Color.Success"
															   Style="height: 6px; border-radius: 0px;" />
										</div>
									</div>

									<!-- Status Footer -->
									<div class="pt-2 d-flex align-center justify-space-between" style="border-top: 1px solid rgba(255, 255, 255, 0.1);">
										<MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.55);">
											Status:
										</MudText>
										<MudText Typo="Typo.caption" Style="@(isCompleted ? "color: #69f0ae; font-weight: 600;" : (totalSubs == 0 && totalFormulas == 0) ? "color: rgba(255, 255, 255, 0.5);" : "color: rgba(255, 255, 255, 0.7); font-weight: 500;")">
											@(isCompleted ? "Completed" : (totalSubs == 0 && totalFormulas == 0) ? "Coming Soon" : "Incomplete")
										</MudText>
									</div>
								</div>
							</MudItem>
						}
					</MudGrid>
				}
			</MudPaper>
		</MudItem>
	</MudGrid>
</MudContainer>

@code {
	private decimal _walletBalance = 0.0000m;
	private DateTime _createdAt = DateTime.UtcNow;
	private List<CurriculumChapterDto> _rootChapters = new();
	private bool _isLoadingChapters = true;

	protected override async Task OnInitializedAsync()
	{
		if (!Session.IsConnected)
		{
			await Session.RestoreSessionAsync();
		}

		if (!Session.IsConnected)
		{
			Nav.NavigateTo("/login");
			return;
		}

		await LoadAccountDetailsAsync();
	}

	private async Task LoadAccountDetailsAsync()
	{
		// 1. Fetch real wallet balance from blockchain via API
		if (!string.IsNullOrWhiteSpace(Session.WalletAddress))
		{
			try
			{
				_walletBalance = await Api.GetWalletBalanceAsync(Session.WalletAddress);
			}
			catch
			{
				_walletBalance = 0.0000m;
			}

			// 2. Fetch real user registration date from DB
			try
			{
				var user = await Api.GetUserByWalletAsync(Session.WalletAddress);
				if (user != null && user.CreatedAt != default)
				{
					_createdAt = user.CreatedAt;
				}
			}
			catch
			{
				_createdAt = DateTime.UtcNow;
			}
		}

		// 3. Fetch real root chapters dynamically from DB
		_isLoadingChapters = true;
		StateHasChanged();
		try
		{
			_rootChapters = await Api.GetRootChaptersAsync();
		}
		catch
		{
			_rootChapters = new List<CurriculumChapterDto>();
		}
		finally
		{
			_isLoadingChapters = false;
			StateHasChanged();
		}
	}

	private string GetRoleTitle()
	{
		return Session.Role switch
		{
			UserRole.Admin => "System Administrator",
			UserRole.Teacher => "Certified Instructor",
			_ => "Registered Student"
		};
	}

	private int GetTotalSubchapters(CurriculumChapterDto chapter)
	{
		return chapter.TotalSubChaptersCount > 0 ? chapter.TotalSubChaptersCount : chapter.SubChaptersCount;
	}

	private int GetTotalFormulas(CurriculumChapterDto chapter)
	{
		return chapter.TotalFormulasCount > 0 ? chapter.TotalFormulasCount : chapter.FormulasCount;
	}

	private int GetCompletedSubchapters(CurriculumChapterDto chapter)
	{
		// Real calculation: count of completed subchapters for this user
		return 0;
	}

	private int GetCompletedFormulas(CurriculumChapterDto chapter)
	{
		// Real calculation: count of completed formulas in this chapter for this user
		if (Session.MarkedFormulas == null || Session.MarkedFormulas.Count == 0)
		{
			return 0;
		}
		return 0;
	}

	private int GetEarnedBadgesCount()
	{
		int earned = 0;
		foreach (var chapter in _rootChapters)
		{
			var totalSubs = GetTotalSubchapters(chapter);
			var totalFormulas = GetTotalFormulas(chapter);
			var completedSubs = GetCompletedSubchapters(chapter);
			var completedFormulas = GetCompletedFormulas(chapter);

			if (totalSubs > 0 && completedSubs >= totalSubs && totalFormulas > 0 && completedFormulas >= totalFormulas)
			{
				earned++;
			}
		}
		return earned;
	}

	private async Task CopyAddress()
	{
		if (!string.IsNullOrEmpty(Session.WalletAddress))
		{
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", Session.WalletAddress);
			Snackbar.Add("Wallet address copied to clipboard!", Severity.Success);
		}
	}

	private async Task Disconnect()
	{
		await Session.LogoutAsync();
		Nav.NavigateTo("/login");
	}
}
