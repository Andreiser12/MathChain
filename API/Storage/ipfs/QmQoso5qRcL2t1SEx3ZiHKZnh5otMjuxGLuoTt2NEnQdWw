          },
          "latexTemplate": "(x + {a})^2",
          "wolframQuery": "expand (x + {a})^2",
          "hint": "Dublul produsului este 2 * x * {a}.",
          "solutionIpfs": null
        },
        {
          "difficulty": "Medium",
          "order": 4,
          "variables": {
            "a": [2, 4],
